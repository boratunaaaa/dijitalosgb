---
import { Image } from 'astro:assets';
import { SITE } from 'astrowind:config';
import logo from '~/assets/images/logo.png';
---

{/*
  Header'da tam marka kilidi değil, ÜST BÖLÜMÜ kullanılıyor.
  Orijinal dosya 3:1 bir afiş: slogan ve üç hizmet satırı da içinde.
  Header'da ~190px genişlikte o alt yazılar okunmaz lekeye dönüşüyordu.
  Tam kilit footer gibi geniş alanlarda duruyor (logo-tam.png).
*/}
<Image
  src={logo}
  alt={SITE?.name}
  width={760}
  height={132}
  loading="eager"
  class="h-9 w-auto sm:h-10"
/>
