---
/**
 * Vaka çalışmaları ve müşteri yorumları bölümü.
 *
 * VERİ YOKSA HİÇ RENDER EDİLMEZ. "Yakında" veya boş kutu göstermek, bölümün
 * hiç olmamasından daha kötü: ziyaretçiye eksikliği duyurur.
 */
import { vakaCalismalari } from '~/data/vaka-calismalari';
import { yayimlanabilirYorumlar } from '~/data/musteri-yorumlari';

const vakalar = vakaCalismalari.slice(0, 3);
const yorumlar = yayimlanabilirYorumlar.slice(0, 3);
const gosterilecek = vakalar.length > 0 || yorumlar.length > 0;
---

{
  gosterilecek && (
    <section class="border-y border-gray-200 bg-gray-50 dark:border-slate-800 dark:bg-slate-900/40">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-14">
        {vakalar.length > 0 && (
          <>
            <h2 class="text-2xl font-bold text-heading md:text-3xl">Saha çalışmalarımızdan</h2>
            <div class="mt-7 grid gap-5 md:grid-cols-3">
              {vakalar.map((v) => (
                <article class="rounded-xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
                  <p class="text-xs font-semibold uppercase tracking-wider text-muted">{v.sektor}</p>
                  <h3 class="mt-1.5 font-semibold text-heading">
                    {v.anonim || !v.adYayimlanabilir ? v.olcek : v.firmaAdi}
                  </h3>
                  <p class="mt-3 text-sm text-muted">
                    <strong class="text-default">Durum:</strong> {v.problem}
                  </p>
                  <p class="mt-2 text-sm text-muted">
                    <strong class="text-default">Sonuç:</strong> {v.sonuc}
                  </p>
                </article>
              ))}
            </div>
          </>
        )}

        {yorumlar.length > 0 && (
          <>
            <h2 class:list={['text-2xl font-bold text-heading md:text-3xl', vakalar.length > 0 && 'mt-12']}>
              İş ortaklarımız ne diyor
            </h2>
            <div class="mt-7 grid gap-5 md:grid-cols-3">
              {yorumlar.map((y) => (
                <figure class="rounded-xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
                  <blockquote class="text-sm leading-relaxed text-default">“{y.yorum}”</blockquote>
                  <figcaption class="mt-4 text-sm">
                    <span class="font-semibold text-heading">{y.ad}</span>
                    <span class="block text-muted">
                      {y.gorev}, {y.firma}
                    </span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </>
        )}
      </div>
    </section>
  )
}
