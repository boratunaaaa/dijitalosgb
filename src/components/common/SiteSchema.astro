---
/**
 * Her sayfada duran kurum ve site kimliği.
 *
 * Google kuruluşu ad, logo, URL, telefon ve hizmet alanı gibi alanlardan
 * tanıyor. Yapay zekâ özetlerinin "bu bir OSGB mi" sorusunu sayfa metninden
 * tahmin etmesini değil buradan okumasını istiyoruz.
 *
 * BOŞ ALAN BASILMAZ: telefon veya e-posta doldurulmadıysa şemaya hiç
 * girmiyor. Uydurma iletişim bilgisi yayımlamak, düzeltmesi en pahalı hata.
 */
import { site, yasalNot } from '~/data/site';
import logo from '~/assets/images/amblem.png';

const kurum: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  description: yasalNot,
  logo: new URL(logo.src, site.url).href,
  areaServed: [
    ...site.hizmetIlleri.map((il) => ({ '@type': 'AdministrativeArea', name: il })),
    { '@type': 'Country', name: 'Türkiye' },
  ],
  knowsAbout: [
    'İş sağlığı ve güvenliği',
    'Risk değerlendirmesi',
    'Acil durum eylem planı',
    'Sağlık ve güvenlik planı',
    'İSG eğitimi',
    'İşyeri hekimliği',
  ],
};
if (site.telefon) kurum.telephone = site.telefon;
if (site.eposta) kurum.email = site.eposta;
/*
 * `memberOf` ve `employee` BİLEREK KALDIRILDI.
 *
 * memberOf: Sahra OSGB ile ilişki bir üyelik değil, iş ortaklığıdır. Schema.org'da
 * bu ilişkiyi doğru anlatan bir property yok; memberOf yazmak arama motoruna ve
 * yapay zekâ sistemlerine gerçekte var olmayan bir kurumsal bağ bildirmek olurdu.
 * İlişki sayfa metninde zaten açıkça anlatılıyor ("yetkili çözüm ortağımız").
 *
 * employee: Dijital OSGB ayrı bir tüzel kişilik değil, bir ticari ad. Veri
 * sorumlusu gerçek kişinin kendisi. Dolayısıyla şirket-çalışan ilişkisi kurmak
 * yanlış bir varlık (entity) üretir. Uzmanın kimliği, ait olduğu yerde —
 * Hakkımızda sayfasının kendi Person şemasında — veriliyor.
 *
 * Kural: doğrulanamayan bir ilişkiyi şemaya koyma. Şema gerçeği yansıtmalı.
 */

const websitesi = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  url: site.url,
  inLanguage: 'tr',
  publisher: { '@id': `${site.url}/#organization` },
};
---
<script type="application/ld+json" set:html={JSON.stringify(kurum)} />
<script type="application/ld+json" set:html={JSON.stringify(websitesi)} />
