---
import "../styles/global.css";
import { site, yasalNot, isOrtagi } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Sayfaya özel schema.org nesnesi (JSON-LD olarak basılır). */
  schema?: Record<string, unknown>;
}
const { title, description, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;

/**
 * Her sayfada duran kimlik şeması. Arama motorlarının ve yapay zekâ
 * özetlerinin "bu kim" sorusunu sayfa metninden tahmin etmesini değil
 * buradan okumasını istiyoruz — özellikle OSGB olmadığımız noktasında.
 */
const kurumSemasi = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: site.url,
  description: yasalNot,
  areaServed: site.hizmetIlleri.map((il) => ({ "@type": "AdministrativeArea", name: il })),
  parentOrganization: undefined,
  memberOf: { "@type": "Organization", name: isOrtagi.ad, address: isOrtagi.adres },
};
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700&family=Source+Sans+3:wght@400;600&family=IBM+Plex+Mono:wght@400&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(kurumSemasi)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/">{site.name}</a>
        <nav class="nav" aria-label="Ana menü">
          <a href="/osgb-hizmeti/">OSGB hizmeti</a>
          <a href="/isg-egitimi/">İSG eğitimi</a>
          <a href="/mobil-saglik-taramasi/">Mobil sağlık</a>
          <a href="/rehber/">Rehber</a>
          <a href="/teklif-al/">Teklif al</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <p class="legal">{yasalNot}</p>
        <p>© {new Date().getFullYear()} {site.name}</p>
      </div>
    </footer>
  </body>
</html>
