---
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

// 404'te de header/footer olsun: kullanıcı kaybolduğunda menüye ve
// hizmetlere erişebilmeli. Çıplak sayfa onu siteden koparıyor.
const metadata = {
  title: 'Sayfa bulunamadı',
  description: 'Aradığınız sayfa bulunamadı. Hizmetlerimize ve İSG rehberine buradan ulaşabilirsiniz.',
  robots: { index: false, follow: true },
};

const yollar = [
  { ad: 'Hizmetler', yol: '/hizmetler/' },
  { ad: 'Sektörler', yol: '/sektorler/' },
  { ad: 'Uzaktan İSG eğitimi', yol: '/isg-egitimi/' },
  { ad: 'Mobil sağlık aracı', yol: '/mobil-saglik-taramasi/' },
  { ad: 'İSG rehberi', yol: '/rehber/' },
  { ad: 'Teklif al', yol: '/teklif-al/' },
];
---
<Layout metadata={metadata}>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-16 sm:py-24 text-center">
    <p class="text-7xl sm:text-8xl font-bold text-primary">404</p>
    <h1 class="mt-6 text-3xl sm:text-4xl font-bold">Aradığınız sayfa bulunamadı</h1>
    <p class="mt-4 text-lg text-muted">
      Bağlantı değişmiş veya sayfa kaldırılmış olabilir. Aşağıdan devam edebilirsiniz.
    </p>

    <ul class="mt-10 grid gap-3 sm:grid-cols-2 text-left">
      {yollar.map((y) => (
        <li>
          <a
            href={getPermalink(y.yol)}
            class="block rounded-lg border border-gray-200 px-5 py-4 font-medium hover:border-primary hover:text-primary transition"
          >
            {y.ad}
          </a>
        </li>
      ))}
    </ul>

    <a href={getPermalink('/')} class="btn btn-primary mt-10 inline-block">Ana sayfaya dön</a>
  </section>
</Layout>
