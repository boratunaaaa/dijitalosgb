---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site } from '~/data/site';

const metadata = {
  title: 'İSG Araçları — Yükümlülük ve Süre Hesaplama',
  description:
    'İş sağlığı ve güvenliği yükümlülüğünüzü yönetmelikteki sayılarla hesaplayan ücretsiz araçlar. Kayıt istemez, verileriniz tarayıcınızdan çıkmaz.',
};

/**
 * Araç sayfaları burada toplanıyor. Liste bilerek kısa: yalnız kaynağı
 * doğrulanmış, sayısı yönetmelikte yazan hesaplar yayımlanıyor. "Ceza
 * hesaplama" gibi her yıl değişen ve yanlış çıktığında ziyaretçiyi zarara
 * sokacak araçlar, verisi teyit edilmeden buraya eklenmez.
 */
const araclar = [
  {
    baslik: 'Tehlike sınıfı sorgulama',
    ozet:
      'NACE kodunuzu veya yaptığınız işi yazın; İşyeri Tehlike Sınıfları Tebliği Ek-1 listesindeki tehlike sınıfını görün. 2.114 faaliyet kodu, resmî listeden.',
    href: '/araclar/tehlike-sinifi-sorgulama/',
    etiket: 'Sorgulama',
  },
  {
    baslik: 'İSG yükümlülük hesaplama',
    ozet:
      'Tehlike sınıfı ve çalışan sayısına göre iş güvenliği uzmanı ve işyeri hekimi için aylık asgari süre, temel eğitim saati, risk değerlendirmesi yenileme yılı.',
    href: '/araclar/isg-yukumluluk-hesaplama/',
    etiket: 'Hesaplama',
  },
  {
    baslik: 'İlk yardımcı sayısı hesaplama',
    ozet:
      'İş yerinizde bulundurmanız gereken asgari temel ilk yardımcı sayısı. Oran tehlike sınıfına göre değişir: her 20, 15 veya 10 çalışana en az bir kişi.',
    href: '/araclar/ilk-yardimci-sayisi-hesaplama/',
    etiket: 'Hesaplama',
  },
  {
    baslik: 'Acil durum ekip sayısı hesaplama',
    ozet:
      'Arama-kurtarma-tahliye ve yangınla mücadele ekipleri için görevlendirmeniz gereken çalışan sayısı. İki ekip ayrı ayrı sayılır, biri diğerinin yerine geçmez.',
    href: '/araclar/acil-durum-ekip-sayisi-hesaplama/',
    etiket: 'Hesaplama',
  },
  {
    baslik: 'İSG eğitimi yenileme tarihi',
    ozet:
      'Son temel eğitimin tarihini girin; yenileme son tarihini ve kaç gün kaldığını görün. Süresi dolmuş eğitim, denetimde eğitim verilmemiş sayılır.',
    href: '/araclar/egitim-yenileme-tarihi-hesaplama/',
    etiket: 'Takvim',
  },
  {
    baslik: 'Risk değerlendirmesi yenileme tarihi',
    ozet:
      'Mevcut risk değerlendirmenizin tarihini girin; en geç ne zaman yenileneceğini görün. Süre dolmadan yenilemeyi gerektiren hâller de listeleniyor.',
    href: '/araclar/risk-degerlendirmesi-yenileme-hesaplama/',
    etiket: 'Takvim',
  },
];
---

<Layout metadata={metadata}>
  <StructuredData
    slot="head"
    schema={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: metadata.title,
      description: metadata.description,
      url: `${site.url}/araclar/`,
      inLanguage: 'tr-TR',
    }}
  />

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <h1 class="text-3xl md:text-4xl font-bold font-heading text-heading tracking-tight mb-4">İSG araçları</h1>
    <p class="text-lg text-muted max-w-3xl mb-10">
      Yükümlülüğünüzü kendiniz görebilmeniz için hazırlandı. Hepsi ücretsiz, kayıt
      istemez ve girdiğiniz bilgiler tarayıcınızdan çıkmaz.
    </p>

    <ul class="grid gap-5 sm:grid-cols-2">
      {
        araclar.map((a) => (
          <li class="rounded-2xl ring-1 ring-gray-200 dark:ring-slate-700 bg-white dark:bg-slate-900 p-6 hover:ring-primary/40 transition">
            <span class="inline-block mb-3 rounded-full bg-primary/10 text-primary px-2.5 py-0.5 text-xs font-semibold">
              {a.etiket}
            </span>
            <h2 class="text-xl font-bold font-heading text-heading mb-2">
              <a href={a.href} class="hover:underline">
                {a.baslik}
              </a>
            </h2>
            <p class="text-muted text-sm">{a.ozet}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 rounded-2xl ring-1 ring-gray-200 dark:ring-slate-700 bg-gray-50 dark:bg-slate-800/60 p-6 md:p-8">
      <h2 class="text-xl font-bold font-heading text-heading mb-2">Mevzuat kaynakları</h2>
      <p class="text-muted mb-5">
        Araçlardaki bütün sayılar aşağıdaki düzenlemelerden geliyor. Kanunun tam
        metnini indirip okuyabilirsiniz.
      </p>
      <a
        href="/belgeler/6331-sayili-is-sagligi-ve-guvenligi-kanunu.pdf"
        class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 font-semibold text-white hover:opacity-90 transition"
        download
      >
        6331 sayılı İş Sağlığı ve Güvenliği Kanunu (PDF)
      </a>
      <ul class="mt-5 space-y-1.5 text-sm text-muted list-disc pl-5">
        <li>İşyeri Tehlike Sınıfları Tebliği ve Ek-1 İşyeri Tehlike Sınıfları Listesi</li>
        <li>İş Güvenliği Uzmanlarının Görev, Yetki, Sorumluluk ve Eğitimleri Hakkında Yönetmelik</li>
        <li>İşyeri Hekimi ve Diğer Sağlık Personelinin Görev, Yetki, Sorumluluk ve Eğitimleri Hakkında Yönetmelik</li>
        <li>Çalışanların İş Sağlığı ve Güvenliği Eğitimlerinin Usul ve Esasları Hakkında Yönetmelik (2/4/2026 tarihli ve 33212 sayılı Resmî Gazete)</li>
        <li>İş Sağlığı ve Güvenliği Risk Değerlendirmesi Yönetmeliği</li>
      </ul>
    </div>
  </section>
</Layout>
