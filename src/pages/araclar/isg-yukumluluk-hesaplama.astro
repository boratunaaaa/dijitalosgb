---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site } from '~/data/site';
import {
  tehlikeSiniflari,
  uzmanDakika,
  hekimDakika,
  gecerliBelgeSiniflari,
  temelEgitim,
  riskDegerlendirmeYil,
  TAM_GUN_UZMAN_ESIGI,
} from '~/data/mevzuat';

const metadata = {
  title: 'İSG Yükümlülük Hesaplama — Uzman ve Hekim Süresi, Eğitim, Risk Değerlendirmesi',
  description:
    'Tehlike sınıfınızı ve çalışan sayınızı girin; iş güvenliği uzmanı ve işyeri hekimi için aylık asgari süreyi, temel eğitim saatini ve risk değerlendirmesi yenileme yılını yönetmelikteki sayılarla hesaplayın.',
};

const sayfaUrl = `${site.url}/araclar/isg-yukumluluk-hesaplama/`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'İSG Yükümlülük Hesaplama',
  url: sayfaUrl,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
  description: metadata.description,
  inLanguage: 'tr-TR',
  isAccessibleForFree: true,
  provider: { '@type': 'Organization', name: site.name, url: site.url },
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Araçlar', item: `${site.url}/araclar/` },
    { '@type': 'ListItem', position: 3, name: 'İSG yükümlülük hesaplama', item: sayfaUrl },
  ],
};

// Hesabın bütün girdileri istemciye veri olarak geçer; sayfa statik kalır,
// sunucuya hiçbir şey gitmez. Ziyaretçinin çalışan sayısı tarayıcısından
// çıkmaz — teklif formunu doldurmayı seçmediği sürece.
const veri = {
  uzmanDakika,
  hekimDakika,
  gecerliBelgeSiniflari,
  temelEgitim,
  riskDegerlendirmeYil,
  tamGunEsigi: TAM_GUN_UZMAN_ESIGI,
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />
  <StructuredData slot="head" schema={breadcrumb} />

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <nav aria-label="Konum" class="text-sm text-muted mb-6">
      <a href="/" class="hover:underline">Ana sayfa</a>
      <span class="mx-1.5">/</span>
      <a href="/araclar/" class="hover:underline">Araçlar</a>
      <span class="mx-1.5">/</span>
      <span class="text-default">İSG yükümlülük hesaplama</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-bold font-heading text-heading tracking-tight mb-4 text-balance">
      İSG yükümlülüğünüzü hesaplayın
    </h1>
    <p class="text-lg text-muted max-w-3xl mb-2">
      Tehlike sınıfınızı ve çalışan sayınızı girin. Aşağıdaki sonuçların tamamı
      yönetmelikte yazan asgari değerlerdir; pazarlık konusu değildir.
    </p>
    <p class="text-sm text-muted max-w-3xl mb-8">
      Tehlike sınıfınızı bilmiyorsanız işyerinizin NACE kodundan belirlenir; SGK
      tescil belgenizde veya İSG-KATİP kaydınızda yazar.
    </p>

    <form id="hesap-formu" class="grid sm:grid-cols-2 gap-5 p-6 rounded-2xl bg-gray-50 dark:bg-slate-800/60 ring-1 ring-gray-200 dark:ring-slate-700">
      <div>
        <label for="sinif" class="block text-sm font-semibold text-heading mb-2">Tehlike sınıfı</label>
        <select
          id="sinif"
          name="sinif"
          class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-3 py-2.5 text-default"
        >
          {tehlikeSiniflari.map((s) => <option value={s.id}>{s.ad}</option>)}
        </select>
      </div>
      <div>
        <label for="calisan" class="block text-sm font-semibold text-heading mb-2">Çalışan sayısı</label>
        <input
          id="calisan"
          name="calisan"
          type="number"
          min="1"
          max="100000"
          step="1"
          value="25"
          inputmode="numeric"
          class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-3 py-2.5 text-default"
        />
      </div>
    </form>

    <div id="sonuc" class="mt-8 grid gap-4 sm:grid-cols-2" aria-live="polite"></div>

    <p id="not-alani" class="mt-6 text-sm text-muted"></p>

    <div class="mt-10 rounded-2xl bg-primary/5 dark:bg-primary/10 ring-1 ring-primary/20 p-6 md:p-8">
      <h2 class="text-xl font-bold font-heading text-heading mb-2">Bu sayılar sizin için ne anlama geliyor?</h2>
      <p class="text-muted mb-5">
        Hesap, asgari süreyi verir; hangi uzmanın hangi işi hangi sırayla yapacağını
        vermez. Teklif isterseniz bu sayıları işyerinizin gerçek durumuyla birlikte
        değerlendirip yazılı planla dönüyoruz.
      </p>
      <a
        href="/teklif-al/"
        class="inline-flex items-center rounded-full bg-primary px-6 py-3 font-semibold text-white hover:opacity-90 transition"
      >
        Bu hesaba göre teklif al
      </a>
    </div>

    <details class="mt-10 group">
      <summary class="cursor-pointer font-semibold text-heading">Hesap hangi düzenlemelere dayanıyor?</summary>
      <ul class="mt-4 space-y-2 text-sm text-muted list-disc pl-5">
        <li>
          Uzman ve hekim görevlendirme süreleri ile belge sınıfı kuralı: İş Güvenliği
          Uzmanlarının ve İşyeri Hekimi ile Diğer Sağlık Personelinin Görev, Yetki,
          Sorumluluk ve Eğitimleri Hakkında Yönetmelikler.
        </li>
        <li>
          Temel eğitim saatleri ve yenileme aralıkları: Çalışanların İş Sağlığı ve
          Güvenliği Eğitimlerinin Usul ve Esasları Hakkında Yönetmelik.
        </li>
        <li>
          Risk değerlendirmesi yenileme aralıkları: İş Sağlığı ve Güvenliği Risk
          Değerlendirmesi Yönetmeliği. İşyerinde değişiklik veya iş kazası olduğunda
          süre beklenmeden yenilenir.
        </li>
        <li>
          Tehlike sınıfı, İşyeri Tehlike Sınıfları Tebliği ekindeki NACE listesine göre
          belirlenir. Bu araç sınıfı belirlemez; girdiğiniz sınıfa göre hesap yapar.
        </li>
      </ul>
    </details>
  </section>

  <script define:vars={{ veri }}>
    const form = document.getElementById('hesap-formu');
    const sonuc = document.getElementById('sonuc');
    const notAlani = document.getElementById('not-alani');

    const okunur = (dakika) => {
      if (dakika < 60) return `${dakika} dakika`;
      const saat = Math.floor(dakika / 60);
      const kalan = Math.round(dakika % 60);
      return kalan === 0 ? `${saat} saat` : `${saat} saat ${kalan} dakika`;
    };

    const digerSaglik = (sinif, calisan) => {
      if (sinif !== 'cok-tehlikeli' || calisan < 10) return null;
      if (calisan <= 49) return 10;
      if (calisan <= 249) return 15;
      return 20;
    };

    const kart = (baslik, deger, aciklama) => `
      <div class="rounded-2xl bg-white dark:bg-slate-900 ring-1 ring-gray-200 dark:ring-slate-700 p-5">
        <dt class="text-xs font-semibold uppercase tracking-wider text-muted">${baslik}</dt>
        <dd class="mt-1.5 text-2xl font-bold text-heading tabular-nums">${deger}</dd>
        <p class="mt-1.5 text-sm text-muted">${aciklama}</p>
      </div>`;

    function hesapla() {
      const sinif = form.sinif.value;
      const calisan = Math.max(1, Math.min(100000, parseInt(form.calisan.value, 10) || 1));

      const uzmanAy = veri.uzmanDakika[sinif] * calisan;
      const hekimAy = veri.hekimDakika[sinif] * calisan;
      const dsp = digerSaglik(sinif, calisan);
      const egitim = veri.temelEgitim[sinif];
      const belgeler = veri.gecerliBelgeSiniflari[sinif];
      const riskYil = veri.riskDegerlendirmeYil[sinif];
      const tamGunUzman = Math.floor(calisan / veri.tamGunEsigi);

      const kartlar = [
        kart(
          'İş güvenliği uzmanı',
          okunur(uzmanAy) + ' / ay',
          `Çalışan başına ayda en az ${veri.uzmanDakika[sinif]} dakika. Asgari belge sınıfı: ${belgeler.length > 1 ? belgeler.slice(0, -1).join(', ') + ' veya ' + belgeler[belgeler.length - 1] : belgeler[0]}.`
        ),
        kart(
          'İşyeri hekimi',
          okunur(hekimAy) + ' / ay',
          `Çalışan başına ayda en az ${veri.hekimDakika[sinif]} dakika.`
        ),
        kart(
          'Temel İSG eğitimi',
          `${egitim.saat} ders saati`,
          `Her çalışan için; en geç ${egitim.yenilemeYil} yılda bir yenilenir.`
        ),
        kart(
          'Risk değerlendirmesi',
          `${riskYil} yılda bir`,
          'İşyerinde değişiklik veya iş kazası olursa süre beklenmeden yenilenir.'
        ),
      ];

      if (dsp !== null) {
        kartlar.push(
          kart(
            'Diğer sağlık personeli',
            okunur(dsp * calisan) + ' / ay',
            `Çok tehlikeli sınıfta ve ${calisan} çalışanda, çalışan başına ayda en az ${dsp} dakika.`
          )
        );
      }

      sonuc.innerHTML = kartlar.join('');

      const notlar = [];
      if (tamGunUzman >= 1) {
        notlar.push(
          `Her ${veri.tamGunEsigi} çalışan için tam gün çalışacak en az bir iş güvenliği uzmanı görevlendirilir; sizin durumunuzda en az ${tamGunUzman} tam gün uzman, kalan çalışan için ek görevlendirme gerekir.`
        );
      }
      if (sinif !== 'az-tehlikeli') {
        notlar.push(
          'Temel eğitimin Ek-1 listesindeki dördüncü konu başlığı, tehlikeli ve çok tehlikeli sınıfta yüz yüze verilir; kalan başlıklar uzaktan verilebilir.'
        );
      }
      if (sinif === 'cok-tehlikeli' && calisan < 10) {
        notlar.push('Çalışan sayısı 10’un altında olduğu için diğer sağlık personeli yükümlülüğü doğmuyor.');
      }
      notAlani.textContent = notlar.join(' ');
    }

    form.addEventListener('input', hesapla);
    form.addEventListener('change', hesapla);
    hesapla();
  </script>
</Layout>
