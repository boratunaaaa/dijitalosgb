---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site } from '~/data/site';
import { bilgiMerkeziVerileri } from '~/data/bilgi-merkezi';

const metadata = {
  title: 'İSG Bilgi Merkezi ve Sözlük — OSGB Terimleri',
  description: 'İş Sağlığı ve Güvenliği (İSG) alanındaki en önemli kavramlar, İSG-Katip, Risk Değerlendirmesi, İşyeri Hekimi zorunlulukları hakkında uzman yanıtları.',
};

const sayfaUrl = `${site.url}/bilgi-merkezi/`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: bilgiMerkeziVerileri.map((s) => ({
    '@type': 'Question',
    name: s.soru,
    acceptedAnswer: { '@type': 'Answer', text: s.cevap },
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Bilgi Merkezi', item: sayfaUrl },
  ],
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={faqSchema} />
  <StructuredData slot="head" schema={breadcrumb} />

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <nav aria-label="Konum" class="text-sm text-muted mb-6">
      <a href="/" class="hover:underline">Ana sayfa</a>
      <span class="mx-1.5">/</span>
      <span class="text-default">Bilgi Merkezi</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-bold font-heading text-heading tracking-tight mb-4">
      İSG Bilgi Merkezi & Sözlük
    </h1>
    <p class="text-lg text-muted mb-8">
      İş Sağlığı ve Güvenliği uygulamalarında en çok merak edilen kavramlar, yasal zorunluluklar ve OSGB süreçleri hakkında hızlı ve net bilgiler.
    </p>

    <div class="mb-12 scroll-mt-24">
      <div class="space-y-4">
        {
          bilgiMerkeziVerileri.map((s) => (
            <div class="group rounded-xl ring-1 ring-gray-200 dark:ring-slate-700 bg-white dark:bg-slate-900 overflow-hidden p-6 hover:shadow-md transition">
              <h2 class="text-xl font-bold font-heading text-heading mb-3">{s.soru}</h2>
              <p class="text-muted leading-relaxed mb-4">{s.cevap}</p>
              {s.link && s.linkMetni && (
                <a href={s.link} class="inline-flex items-center text-sm font-semibold text-primary hover:underline">
                  {s.linkMetni}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              )}
            </div>
          ))
        }
      </div>
    </div>

    <div class="rounded-2xl bg-primary/5 dark:bg-primary/10 ring-1 ring-primary/20 p-6 md:p-8">
      <h2 class="text-xl font-bold font-heading text-heading mb-2">Daha fazla bilgiye mi ihtiyacınız var?</h2>
      <p class="text-muted mb-5">
        İşyerinize özgü İSG gereksinimleri ve yasal yükümlülükleriniz için uzmanlarımızla hemen görüşün.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href="/teklif-al/"
          class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 font-semibold text-white hover:opacity-90 transition"
        >
          Ücretsiz Danışmanlık Alın
        </a>
        {
          site.telefon && (
            <a
              href={`tel:${site.telefonHref}`}
              class="inline-flex items-center justify-center rounded-full ring-1 ring-gray-300 dark:ring-slate-600 px-6 py-3 font-semibold text-default hover:bg-gray-50 dark:hover:bg-slate-800 transition"
            >
              {site.telefon}
            </a>
          )
        }
      </div>
    </div>
  </section>

  {/*
    KAYNAK GÖSTERİMİ (ek talimat #61): Bu sayfa mevzuat iddiaları taşıyor.
    Hukuki kapının kuralı, iddianın kaynağa bağlanmasını istiyor; kaynaksız
    mevzuat anlatımı sayfayı düşürür. Bağlantılar yeni sekmede ve rel
    noopener ile açılıyor.
  */}
  <section class="mx-auto max-w-4xl px-4 pb-14 sm:px-6">
    <h2 class="text-lg font-bold text-heading">Kaynaklar ve ilgili mevzuat</h2>
    <p class="mt-2 text-sm text-muted">
      Bu sayfadaki yükümlülükler aşağıdaki düzenlemelere dayanır. Kendi iş yerinize
      düşen kapsam tehlike sınıfınıza ve çalışan sayınıza göre değişir.
    </p>
    <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-muted">
      {
        [
          { ad: '6331 sayılı İş Sağlığı ve Güvenliği Kanunu', url: 'https://www.mevzuat.gov.tr/mevzuatmetin/1.5.6331.pdf' },
          { ad: 'İş Sağlığı ve Güvenliği Risk Değerlendirmesi Yönetmeliği', url: 'https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=16925&MevzuatTur=7&MevzuatTertip=5' },
          { ad: 'İşyerlerinde Acil Durumlar Hakkında Yönetmelik', url: 'https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=18721&MevzuatTur=7&MevzuatTertip=5' },
          { ad: 'İş Ekipmanlarının Kullanımında Sağlık ve Güvenlik Şartları Yönetmeliği', url: 'https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=18704&MevzuatTur=7&MevzuatTertip=5' },
          { ad: 'Çalışanların İSG Eğitimlerinin Usul ve Esasları Hakkında Yönetmelik (2 Nisan 2026, RG 33212)', url: 'https://www.resmigazete.gov.tr/' },
          { ad: 'Çalışanların Patlayıcı Ortamların Tehlikelerinden Korunması Hakkında Yönetmelik', url: 'https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=18697&MevzuatTur=7&MevzuatTertip=5' },
        ].map((k) => (
          <li>
            <a class="underline underline-offset-4" href={k.url} rel="nofollow noopener" target="_blank">
              {k.ad}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

</Layout>
