---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site, uzman } from '~/data/site';
import { yazilar, kategoriAdlari } from '~/data/blog';

export function getStaticPaths() {
  return yazilar.map((y) => ({ params: { slug: y.slug }, props: { y } }));
}

const { y } = Astro.props;
const url = `${site.url}/blog/${y.slug}/`;

const metadata = {
  title: y.baslik,
  description: y.ozet.length > 155 ? y.ozet.slice(0, 152).replace(/\s+\S*$/, '') + '…' : y.ozet,
};

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: y.baslik,
    description: y.ozet,
    datePublished: y.tarih,
    dateModified: y.tarih,
    url,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    inLanguage: 'tr-TR',
    /*
     * AUTHOR ORGANIZATION — BİLEREK, PERSON DEĞİL.
     *
     * Bu yazılar tek tek bir kişi tarafından kaleme alınmadı; bilgi merkezi
     * içeriği olarak üretildi. Şemadaki `author` alanı arama motorlarına
     * yapılan bir OLGU BEYANIDIR: oraya bir kişi adı yazmak, o kişinin
     * metni yazdığını bildirmek demektir.
     *
     * Aşağıdaki uzman kutusu kaldırılmadı — sitenin arkasındaki uzmanı
     * tanıtmak doğru ve E-E-A-T açısından değerli. Ama kutu "bu yazıyı o
     * yazdı" demiyor, "bu siteyi o yürütüyor" diyor.
     *
     * Yazılar gerçekten uzman incelemesinden geçirilirse buraya ayrıca
     * `reviewedBy` eklenebilir; inceleme yapılmadan öyle gösterilmiyor.
     */
    author: { '@type': 'Organization', name: `${site.name} Bilgi Merkezi`, url: site.url },
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Rehber', item: `${site.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: y.baslik, item: url },
    ],
  },
];

// Aynı kategoriden diğer yazılar; okuyucu bitirince nereye gideceğini bilsin.
const benzer = yazilar.filter((d) => d.slug !== y.slug && d.kategori === y.kategori).slice(0, 3);

const tarihYaz = (t: string) =>
  new Date(t).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />

  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <nav aria-label="Konum" class="text-sm text-muted mb-6">
      <a href="/" class="hover:underline">Ana sayfa</a>
      <span class="mx-1.5">/</span>
      <a href="/blog/" class="hover:underline">Rehber</a>
    </nav>

    <div class="flex items-center gap-3 mb-4 text-xs">
      <span class="rounded-full bg-primary/10 text-primary px-2.5 py-0.5 font-semibold">
        {kategoriAdlari[y.kategori]}
      </span>
      <span class="text-muted">{y.sure} dk okuma</span>
      <time datetime={y.tarih} class="text-muted">{tarihYaz(y.tarih)}</time>
    </div>

    <h1 class="text-3xl md:text-4xl font-bold font-heading text-heading tracking-tight mb-5 text-balance">
      {y.baslik}
    </h1>

    <p class="text-lg text-muted mb-10 pb-8 border-b border-gray-200 dark:border-slate-700">{y.ozet}</p>

    <div class="space-y-5">
      {
        y.govde.map((b) =>
          b.tip === 'h2' ? (
            <h2 class="text-xl md:text-2xl font-bold font-heading text-heading pt-4">{b.metin}</h2>
          ) : b.tip === 'p' ? (
            <p class="text-default leading-relaxed">{b.metin}</p>
          ) : b.tip === 'liste' ? (
            <ul class="space-y-2 pl-1">
              {b.maddeler.map((m) => (
                <li class="flex gap-3 text-default leading-relaxed">
                  <span class="text-primary shrink-0 font-bold" aria-hidden="true">
                    ·
                  </span>
                  <span>{m}</span>
                </li>
              ))}
            </ul>
          ) : (
            <aside class="rounded-2xl bg-primary/5 dark:bg-primary/10 ring-1 ring-primary/20 p-5 text-default leading-relaxed">
              {b.metin}
            </aside>
          )
        )
      }
    </div>

    {
      y.baglantilar && y.baglantilar.length > 0 && (
        <div class="mt-10 pt-8 border-t border-gray-200 dark:border-slate-700">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-muted mb-3">İlgili sayfalar</h2>
          <ul class="flex flex-wrap gap-2">
            {y.baglantilar.map((b) => (
              <li>
                <a
                  href={b.href}
                  class="inline-flex rounded-full bg-gray-100 dark:bg-slate-800 px-3.5 py-1.5 text-sm font-medium text-default hover:bg-primary/10 hover:text-primary transition"
                >
                  {b.metin}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="mt-10 rounded-2xl bg-primary/5 dark:bg-primary/10 ring-1 ring-primary/20 p-6 md:p-8">
      <h2 class="text-xl font-bold font-heading text-heading mb-2">İşyeriniz için ne gerekiyor?</h2>
      <p class="text-muted mb-5">
        Ne iş yaptığınızı, kaç çalışanınız olduğunu ve nerede olduğunuzu söyleyin;
        yükümlülüğünüzü çıkarıp yazılı gönderelim.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href="/teklif-al/"
          class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 font-semibold text-white hover:opacity-90 transition"
        >
          Ücretsiz ön değerlendirme
        </a>
        <a
          href="/araclar/isg-yukumluluk-hesaplama/"
          class="inline-flex items-center justify-center rounded-full ring-1 ring-gray-300 dark:ring-slate-600 px-6 py-3 font-semibold text-default hover:bg-gray-50 dark:hover:bg-slate-800 transition"
        >
          Önce kendim hesaplayayım
        </a>
      </div>
    </div>

    {
      uzman.unvan && (
        <div class="mt-12 p-6 md:p-8 rounded-2xl bg-gray-50 dark:bg-slate-800 ring-1 ring-gray-200 dark:ring-slate-700 flex flex-col md:flex-row items-center md:items-start gap-6">
          <div class="shrink-0">
            <div class="w-20 h-20 rounded-full bg-primary/20 flex items-center justify-center text-primary font-bold text-2xl font-heading">
              {uzman.belgeSinifi || 'İSG'}
            </div>
          </div>
          <div class="text-center md:text-left">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted mb-1">Siteyi yürüten uzman</p>
            {uzman.ad && <h3 class="text-xl font-bold font-heading text-heading">{uzman.ad}</h3>}
            <p class="text-primary font-semibold text-sm mb-2">{uzman.unvan} {uzman.belgeSinifi && `(${uzman.belgeSinifi} Sınıfı)`}</p>
            <p class="text-muted text-sm">{uzman.ozet}</p>
            <p class="text-muted text-sm mt-2">
              Bu içerik {site.name} bilgi merkezi için hazırlandı; saha ve danışmanlık
              süreçlerini yürüten uzman yukarıdadır.
            </p>
            <div class="mt-3">
               <a href="/hakkimizda/" class="text-sm font-semibold text-primary hover:underline">Hakkında daha fazla bilgi &rarr;</a>
            </div>
          </div>
        </div>
      )
    }

    {
      benzer.length > 0 && (
        <div class="mt-12">
          <h2 class="text-xl font-bold font-heading text-heading mb-4">Bunlar da ilginizi çekebilir</h2>
          <ul class="space-y-3">
            {benzer.map((d) => (
              <li class="rounded-xl ring-1 ring-gray-200 dark:ring-slate-700 bg-white dark:bg-slate-900 p-4">
                <a href={`/blog/${d.slug}/`} class="font-semibold text-heading hover:underline">
                  {d.baslik}
                </a>
                <p class="text-sm text-muted mt-1">{d.ozet}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </article>
</Layout>
