---
/**
 * Bölge × sektör içerik sayfası şablonu.
 *
 * TEK ŞABLON, İNSAN ONAYLI: Otomatik üretim yalnız `bolge-sektor.ts`'e veri
 * ekler; düzen, şema ve bağlantı kuralları burada sabit durur.
 *
 * LocalBusiness şeması BİLEREK YOK: Dijital OSGB bu ilçelerde fiziksel bir
 * işletme değil. İlçe sayfasına adres uydurmak yanlış varlık üretir.
 * Service + FAQPage + BreadcrumbList kullanılıyor; üçü de sayfada gerçekten
 * bulunan içeriği anlatıyor.
 */
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site } from '~/data/site';
import { bolgeSektorSayfalari } from '~/data/bolge-sektor';

export function getStaticPaths() {
  return bolgeSektorSayfalari.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;

const url = `${site.url}/bolge/${s.slug}/`;
const metadata = {
  title: s.seoBaslik,
  description: s.metaAciklama,
  robots: s.indexDisi ? { index: false, follow: true } : undefined,
};

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Bilgi merkezi', item: `${site.url}/isg-kutuphanesi/` },
      { '@type': 'ListItem', position: 3, name: s.h1, item: url },
    ],
  },
];

/*
 * ŞEMA SAYFA TİPİNE GÖRE SEÇİLİYOR — hepsine Service basılmıyor.
 *
 * "Tuzla metal ve kaynak işlerinde iş güvenliği" bir REHBER sayfasıdır;
 * birincil amacı hizmet satmak değil, o iş kolunun risklerini ve
 * yükümlülüklerini anlatmaktır. Ona Service şeması basmak, sayfanın gerçek
 * niteliğiyle uyuşmayan bir varlık bildirmek olurdu. Service yalnız sayfanın
 * ana amacı doğrudan hizmet sunmaksa (ilce-hizmet) kullanılıyor.
 */
if (s.tip === 'ilce-hizmet') {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.h1,
    description: s.metaAciklama,
    url,
    inLanguage: 'tr-TR',
    // areaServed yalnız GERÇEKTEN saha hizmeti verilen bölgelerde ilçe adı
    // taşır; verilmiyorsa hizmet ülke geneli uzaktan olarak tanımlanır.
    areaServed: s.sahaHizmeti
      ? [{ '@type': 'AdministrativeArea', name: s.ilce ? `${s.ilce}, ${s.il}` : s.il }]
      : [{ '@type': 'Country', name: 'Türkiye' }],
    provider: { '@id': `${site.url}/#organization` },
  });
} else if (s.tip === 'ilce') {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: s.h1,
    description: s.metaAciklama,
    url,
    inLanguage: 'tr-TR',
    isPartOf: { '@id': `${site.url}/#website` },
  });
} else {
  /*
   * AUTHOR/PUBLISHER GERÇEĞİ YANSITIYOR (ek talimat #59).
   * "Yazar: Mehmet Kadir Uğur" YAZILMIYOR: bu metinler bilgi merkezi
   * içeriğidir ve tek tek insan eliyle yazılmış gibi gösterilmemeli.
   * Publisher kurumun kendisi; uzman incelemesi yapılmadığı sürece
   * reviewer alanı da eklenmiyor.
   */
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: s.h1,
    description: s.metaAciklama,
    url,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    inLanguage: 'tr-TR',
    datePublished: s.uretim.yayinTarihi,
    dateModified: s.uretim.guncellemeTarihi ?? s.uretim.yayinTarihi,
    author: { '@type': 'Organization', name: `${site.name} Bilgi Merkezi`, url: site.url },
    publisher: { '@id': `${site.url}/#organization` },
    ...(s.kaynaklar.filter((k) => k.url).length > 0
      ? { citation: s.kaynaklar.filter((k) => k.url).map((k) => k.url) }
      : {}),
  });
}

/*
 * FAQPage OTOMATİK DEĞİL (ek talimat #4).
 * `sss` dolu diye şema basmıyoruz; karar veri katmanındaki `faqSemasi`
 * alanında. Rich result beklentisiyle yapısal veri eklemek, hem Google'ın
 * daralan desteği hem de bakım yükü nedeniyle tercih edilmiyor. SSS
 * içeriğinin kullanıcıya ve yapay zekâ özetlerine değeri metnin kendisinde.
 */
if (s.faqSemasi && s.sss.length > 0) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.sss.map((q) => ({
      '@type': 'Question',
      name: q.soru,
      acceptedAnswer: { '@type': 'Answer', text: q.cevap },
    })),
  });
}
---

<Layout metadata={metadata}>
  {schema.map((x) => <StructuredData slot="head" schema={x} />)}

  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 md:py-14">
    <nav aria-label="Konum" class="mb-6 text-sm text-muted">
      <a href="/" class="hover:underline">Ana sayfa</a>
      <span class="mx-1.5">/</span>
      <a href="/isg-kutuphanesi/" class="hover:underline">Bilgi merkezi</a>
      <span class="mx-1.5">/</span>
      <span class="text-default">{s.ilce ?? s.il}</span>
    </nav>

    <p class="text-sm font-semibold uppercase tracking-wider text-primary">
      {s.ilce ? `${s.ilce} · ${s.il}` : s.il}
    </p>
    <h1 class="mt-2 text-balance text-3xl font-bold font-heading tracking-tight text-heading md:text-4xl">
      {s.h1}
    </h1>
    <p class="mt-4 text-lg text-muted">{s.giris}</p>

    <div class="mt-7 flex flex-wrap gap-3">
      <a
        href={s.cta?.href ?? '/teklif-al/'}
        class="inline-flex items-center rounded-full bg-primary px-6 py-3 font-semibold text-white transition hover:opacity-90"
      >
        {s.cta?.metin ?? 'Ücretsiz ön değerlendirme'}
      </a>
      <a
        href={`https://wa.me/${site.whatsapp}`}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center rounded-full border border-gray-300 px-6 py-3 font-semibold text-default transition hover:border-primary dark:border-slate-600"
      >
        WhatsApp'tan uzmanla görüşün
      </a>
    </div>

    {
      s.bolumler.map((b) => (
        <section class="mt-10">
          <h2 class="text-2xl font-bold text-heading">{b.baslik}</h2>
          {b.paragraflar?.map((p) => <p class="mt-3 leading-relaxed text-muted">{p}</p>)}
          {b.maddeler && b.maddeler.length > 0 && (
            <ul class="mt-4 list-disc space-y-2 pl-5 text-muted">
              {b.maddeler.map((m) => (
                <li>{m}</li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    {
      s.sss.length > 0 && (
        <section class="mt-12">
          <h2 class="text-2xl font-bold text-heading">Sık sorulan sorular</h2>
          <dl class="mt-5 divide-y divide-gray-200 dark:divide-slate-700">
            {s.sss.map((q) => (
              <div class="py-4">
                <dt class="font-semibold text-heading">{q.soru}</dt>
                <dd class="mt-2 leading-relaxed text-muted">{q.cevap}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <section class="mt-12 rounded-2xl bg-gray-50 p-6 dark:bg-slate-800/60">
      <h2 class="text-xl font-bold text-heading">İlgili sayfalar</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {
          s.icLinkler.map((l) => (
            <li>
              <a class="underline underline-offset-4 hover:no-underline" href={l.href}>
                {l.metin}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      s.kaynaklar.length > 0 && (
        <section class="mt-10">
          <h2 class="text-lg font-bold text-heading">Kaynaklar</h2>
          <p class="mt-2 text-sm text-muted">
            Bu sayfadaki mevzuat bilgileri aşağıdaki düzenlemelere dayanır. Yükümlülüğünüzün
            kesin kapsamı iş yerinizin tehlike sınıfına ve çalışan sayısına göre değişir.
          </p>
          <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-muted">
            {s.kaynaklar.map((k) => (
              <li>{k.url ? <a class="underline underline-offset-4" href={k.url} rel="nofollow noopener" target="_blank">{k.ad}</a> : k.ad}</li>
            ))}
          </ul>
        </section>
      )
    }
  </section>
</Layout>
