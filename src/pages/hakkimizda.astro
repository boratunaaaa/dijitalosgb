---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site, isOrtagi, ekip, uzman } from '~/data/site';

const metadata = {
  title: 'Hakkımızda',
  description: `${site.name} kimdir, hizmeti kim veriyor ve yetki sınırları nedir.`,
};

// Person şeması: Google'ın "bu içeriği kim yazıyor" sorusunun cevabı.
// Yalnız DOĞRULANMIŞ alanlar basılıyor; belge sınıfı ve diploma teyit
// edilmeden şemaya da sayfaya da girmiyor.
const kisi: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: uzman.ad,
  jobTitle: uzman.belgeSinifi ? `${uzman.belgeSinifi} Sınıfı ${uzman.unvan}` : uzman.unvan,
  worksFor: { '@type': 'Organization', name: site.name, url: site.url },
  knowsAbout: ['İş sağlığı ve güvenliği', 'Risk değerlendirmesi', 'Acil durum planlaması', 'İSG eğitimi'],
};
if (uzman.egitim.length) kisi.alumniOf = uzman.egitim;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Hakkımızda',
    url: `${site.url}/hakkimizda/`,
  },
  kisi,
];
---
<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <HeroText
    title="Hakkımızda"
    subtitle="Ne olduğumuzu ve ne olmadığımızı baştan yazıyoruz; bu işte en pahalı yanlış anlaşılma budur."
  />

  <Content title="Ne yapıyoruz, ne yapmıyoruz">
    <Fragment slot="content">
      <p>
        <strong>{site.name} bir OSGB değildir.</strong> OSGB, Çalışma ve Sosyal Güvenlik
        Bakanlığı tarafından yetkilendirilen ve belirli fiziki şartları sağlaması gereken
        bir yapıdır. Saha iş sağlığı ve güvenliği hizmetleri — iş güvenliği uzmanı ve
        işyeri hekimi görevlendirmesi — yetkili iş ortağımız <strong>{isOrtagi.ad}</strong>
        tarafından verilir.
      </p>
      <p class="mt-3">
        İSG eğitimlerini, risk değerlendirmesi desteğini, acil durum planlarını ve
        dokümantasyonu ise doğrudan biz yürütürüz. Bu hatlarda aracı yoktur.
      </p>
    </Fragment>
  </Content>

  <Features
    title="Yetki sınırları"
    columns={2}
    items={[
      {
        title: 'Saha hizmeti: ' + site.hizmetIlleri.join(', '),
        description: "OSGB'ler kurulu oldukları il ve sınır komşusu illerde hizmet verebilir; ötesi için o ilde şube açmak gerekir.",
        icon: 'tabler:map-pin',
      },
      {
        title: 'Danışmanlık ve eğitim: 81 il',
        description: 'Danışmanlık, dokümantasyon ve eğitimde coğrafi sınır yoktur.',
        icon: 'tabler:world',
      },
    ]}
  />

  <Content
    isReversed
    title="Hizmeti kim yürütüyor"
    items={[
      ...(uzman.belgeSinifi
        ? [{ title: `${uzman.belgeSinifi} Sınıfı ${uzman.unvan}`, icon: 'tabler:certificate' }]
        : [{ title: uzman.unvan, icon: 'tabler:certificate' }]),
      ...(uzman.belgeNo ? [{ title: `Belge no: ${uzman.belgeNo}`, icon: 'tabler:id-badge' }] : []),
      ...uzman.egitim.map((e) => ({ title: e, icon: 'tabler:school' })),
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold">{uzman.ad}</h3>
      <p class="mt-3">
        İSG eğitimlerini ve danışmanlık süreçlerini doğrudan yürütür; saha
        hizmetlerinde iş ortağıyla koordinasyonu sağlar.
      </p>
      {uzman.deneyim && <p class="mt-3">{uzman.deneyim}</p>}
    </Fragment>
  </Content>

  <Features
    title="Hizmet ekibi"
    subtitle="Saha personeli yetki belgeli iş ortağımızın bünyesinde görev yapar; eğitim tarafını doğrudan biz yürütürüz."
    columns={1}
    items={ekip.map((e) => ({ title: e.baslik, description: e.aciklama, icon: 'tabler:users' }))}
  />

  <Content title="İş ortağımız">
    <Fragment slot="content">
      <p><strong>{isOrtagi.ad}</strong></p>
      <p class="mt-2 text-muted">{isOrtagi.adres}</p>
      {isOrtagi.yetkiBelgeNo && <p class="mt-2">Yetki belgesi no: <strong>{isOrtagi.yetkiBelgeNo}</strong></p>}
    </Fragment>
  </Content>

  <CallToAction
    title="Yükümlülüğünüzü konuşalım"
    actions={[{ variant: 'primary', text: 'Teklif al', href: '/teklif-al/' }]}
  />
</Layout>
