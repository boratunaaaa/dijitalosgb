---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site, isOrtagi, ekip, uzman } from '~/data/site';

const metadata = {
  title: 'Hakkımızda',
  description: `${site.name} hangi işleri üstleniyor, saha hizmetini kim yürütüyor, hangi illerde çalışıyoruz ve hizmet ekibinde kimler var.`,
};

// Person şeması: Google'ın "bu içeriği kim yazıyor" sorusunun cevabı.
// Yalnız DOĞRULANMIŞ alanlar basılıyor; belge sınıfı ve diploma teyit
// edilmeden şemaya da sayfaya da girmiyor.
// Ad boşsa Person şeması HİÇ üretilmiyor: adsız bir Person düğümü hem
// şema açısından geçersiz hem de "kim" sorusuna cevap vermiyor.
const kisi: Record<string, unknown> | null = uzman.ad
  ? {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: uzman.ad,
  jobTitle: uzman.belgeSinifi ? `${uzman.belgeSinifi} Sınıfı ${uzman.unvan}` : uzman.unvan,
  worksFor: { '@type': 'Organization', name: site.name, url: site.url },
  knowsAbout: ['İş sağlığı ve güvenliği', 'Risk değerlendirmesi', 'Acil durum planlaması', 'İSG eğitimi'],
    }
  : null;
if (kisi && uzman.egitim.length) kisi.alumniOf = uzman.egitim;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Hakkımızda',
    url: `${site.url}/hakkimizda/`,
  },
  ...(kisi ? [kisi] : []),
];
---
<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <HeroText
    title="Hakkımızda"
    subtitle="İş sağlığı ve güvenliğinde ihtiyacınız olan her başlığı tek elden yürütüyoruz. Hangi işi kimin yaptığını da açıkça yazıyoruz."
  />

  <Content title="İşin hangi kısmını kim yürütüyor">
    <Fragment slot="content">
      <p>
        İSG eğitimlerini <strong>doğrudan biz</strong> veriyoruz. Risk değerlendirmesi, acil
        durum planı ve işyeri dokümantasyonunda ise <strong>hazırlama ve uygulama desteği</strong>
        sağlıyoruz: saha incelemesini yapar, dosyayı kurar, ekibe uzman desteği veririz.
        Bu hatlarda aracı yok — eğitimi veren de, dosyayı kuran da aynı ekip.
      </p>
      <p class="mt-3 text-sm text-muted">
        Mevzuat gereği risk değerlendirmesi, işveren veya vekilinin başkanlığında; iş güvenliği
        uzmanı, işyeri hekimi, çalışan temsilcileri ve destek elemanlarından oluşan bir ekipçe
        yapılır. Acil durum planının hazırlanması da işverenin yükümlülüğüdür. Dışarıdan destek
        almak bu yükümlülüğü ortadan kaldırmaz; biz süreci kurar ve yürütürüz, sorumluluk
        6331 sayılı Kanun gereği işverende kalır.
      </p>
      <p class="mt-3">
        Saha görevlendirmesi gerektiren hizmetler — iş güvenliği uzmanı ve işyeri hekimi
        ataması — yetkili çözüm ortağımız <strong>{isOrtagi.ad}</strong> üzerinden
        yürütülür. Süreci biz kurar ve takip ederiz; görevlendirme yetkili kuruluş
        adına kayda geçer.
      </p>
      <p class="mt-4 font-medium text-heading">Yetkili OSGB altyapısıyla saha hizmeti</p>
      <p class="mt-2 text-muted">
        İş güvenliği uzmanı ve işyeri hekimi görevlendirmeleri, Bakanlıkça yetkilendirilmiş
        çözüm ortağımız <strong>{isOrtagi.ad}</strong> üzerinden yürütülür. Eğitim, danışmanlık
        ve dokümantasyon süreçleri {site.name} tarafından yönetilir. Böylece yetki gerektiren
        işler yetkili kuruluşta kalırken, süreci tek bir muhatapla yürütürsünüz.
      </p>
      <p class="mt-3 text-sm text-muted">
        {site.name} bir OSGB değildir; OSGB, Çalışma ve Sosyal Güvenlik Bakanlığınca
        yetkilendirilen ve belirli şartları sağlaması gereken bir yapıdır.
      </p>
    </Fragment>
  </Content>

  <Features
    title="Yetki sınırları"
    columns={2}
    items={[
      {
        title: 'Saha hizmeti: ' + site.hizmetIlleri.join(', '),
        description: "OSGB'ler kurulu oldukları il ve sınır komşusu illerde hizmet verebilir; ötesi için o ilde şube açmak gerekir.",
        icon: 'tabler:map-pin',
      },
      {
        title: 'Eğitim ve danışmanlık: 81 il',
        description: 'Eğitim, dokümantasyon ve danışmanlıkta coğrafi sınır yok; Türkiye’nin her yerinden çalışıyoruz.',
        icon: 'tabler:world',
      },
    ]}
  />

  <Content
    isReversed
    title="Uzmanlık altyapımız"
    items={[
      ...(uzman.belgeSinifi
        ? [{ title: `${uzman.belgeSinifi} Sınıfı ${uzman.unvan}`, icon: 'tabler:certificate' }]
        : [{ title: uzman.unvan, icon: 'tabler:certificate' }]),
      ...(uzman.belgeNo ? [{ title: `Belge no: ${uzman.belgeNo}`, icon: 'tabler:id-badge' }] : []),
      ...uzman.egitim.map((e) => ({ title: e, icon: 'tabler:school' })),
    ]}
  >
    <Fragment slot="content">
      {uzman.ad && <h3 class="text-2xl font-bold">{uzman.ad}</h3>}
      <p class="mt-1 text-sm font-medium uppercase tracking-wider text-muted">
        {uzman.belgeSinifi ? `${uzman.belgeSinifi} sınıfı ${uzman.unvan.toLocaleLowerCase('tr-TR')}` : uzman.unvan}
      </p>
      <p class="mt-3">
        Hizmet ve danışmanlık süreçlerini yürüten A sınıfı iş güvenliği uzmanı. Dosyayı kuran,
        eğitimi veren ve saha tarafında iş ortağıyla koordinasyonu sağlayan kişi aynı — talebiniz
        elden ele dolaşmıyor.
      </p>
      {uzman.deneyim && <p class="mt-3">{uzman.deneyim}</p>}
    </Fragment>
  </Content>

  <Features
    title="Çözüm ağımız"
    subtitle="Yetki gerektiren her başlık, o yetkiye sahip kişi veya kuruluş tarafından yürütülür. Koordinasyonu tek merkezden biz sağlarız."
    columns={1}
    items={ekip.map((e) => ({ title: e.baslik, description: e.aciklama, icon: 'tabler:users' }))}
  />

  <Content title="İş ortağımız">
    <Fragment slot="content">
      <p><strong>{isOrtagi.ad}</strong></p>
      <p class="mt-2 text-muted">{isOrtagi.adres}</p>
      {isOrtagi.yetkiBelgeNo && <p class="mt-2">Yetki belgesi no: <strong>{isOrtagi.yetkiBelgeNo}</strong></p>}
    </Fragment>
  </Content>

  <CallToAction
    title="Yükümlülüğünüzü konuşalım"
    actions={[{ variant: 'primary', text: 'Teklif al', href: '/teklif-al/' }]}
  />
</Layout>
