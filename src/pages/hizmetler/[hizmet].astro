---
import Layout from '~/layouts/PageLayout.astro';
import { mykMeslekOrnekleri, mykKaynak } from '~/data/myk-meslekler';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Note from '~/components/widgets/Note.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site, isOrtagi } from '~/data/site';
import { hizmetler } from '~/data/hizmetler';

export function getStaticPaths() {
  return hizmetler.map((h) => ({ params: { hizmet: h.slug }, props: { h } }));
}
const { h } = Astro.props;

const metadata = { title: h.h1, description: h.ozet };
const url = `${site.url}/hizmetler/${h.slug}/`;

const alan =
  h.kapsam === 'saha'
    ? site.hizmetIlleri.map((i) => ({ '@type': 'AdministrativeArea', name: i }))
    : [{ '@type': 'Country', name: 'Türkiye' }];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: h.ad,
    description: h.ozet,
    serviceType: h.ad,
    url,
    areaServed: alan,
    provider: h.kapsam === 'saha'
      ? { '@type': 'Organization', name: isOrtagi.ad, address: isOrtagi.adres }
      : { '@type': 'Organization', name: site.name, url: site.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Hizmetler', item: `${site.url}/hizmetler/` },
      { '@type': 'ListItem', position: 3, name: h.ad, item: url },
    ],
  },
];
---
<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <HeroText
    tagline={h.kapsam === 'saha' ? site.hizmetIlleri.join(' · ') : 'Türkiye geneli · 81 il'}
    title={h.h1}
    subtitle={h.giris}
    actions={[{ variant: 'primary', text: 'Fiyat teklifi al', href: '/teklif-al/' }]}
  />

  {h.onemliNot && (
    <Note title="Dikkat" description={h.onemliNot} />
  )}

  <Features
    title="Neyi kapsıyor"
    columns={2}
    items={h.kapsamMaddeleri.map((m) => ({ title: m.baslik, description: m.aciklama, icon: 'tabler:circle-check' }))}
  />

  {
    h.slug === 'mesleki-yeterlilik-belgesi' && (
      <section class="max-w-5xl mx-auto px-4 sm:px-6 py-8 md:py-12">
        <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading tracking-tight mb-3">
          Belgesi zorunlu mesleklerden örnekler
        </h2>
        <p class="text-muted max-w-3xl mb-2">
          Aşağıdakiler, tehlikeli ve çok tehlikeli işlerde sık karşılaştığımız ve
          tebliğ listesinde yer alan mesleklerden örneklerdir.
        </p>
        <p class="text-sm text-muted max-w-3xl mb-8">
          Bu tam liste değildir ve öyle sunmuyoruz: zorunlu meslekler tebliğlerle
          kademeli olarak belirlendi ve genişlemeye devam ediyor. Kesin ve güncel
          liste {mykKaynak.kurum} tarafından yayımlanır; sizin personel listenizi
          meslek meslek o listeyle karşılaştırıyoruz.
        </p>

        <div class="grid gap-5 sm:grid-cols-2">
          {mykMeslekOrnekleri.map((g) => (
            <div class="rounded-2xl ring-1 ring-gray-200 dark:ring-slate-700 bg-white dark:bg-slate-900 p-5">
              <h3 class="font-bold text-heading mb-3">{g.sektor}</h3>
              <ul class="flex flex-wrap gap-2">
                {g.meslekler.map((m) => (
                  <li class="rounded-full bg-gray-100 dark:bg-slate-800 px-3 py-1 text-sm text-default">{m}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <p class="mt-6 text-sm text-muted">
          Güncel ulusal yeterlilikler ve yetkilendirilmiş belgelendirme kuruluşları:{' '}
          <a href={mykKaynak.url} target="_blank" rel="noopener" class="text-primary font-semibold hover:underline">
            {mykKaynak.kurum}
          </a>
        </p>
      </section>
    )
  }

  <FAQs
    schema
    title="Sık sorulanlar"
    items={h.sss.map((q) => ({ title: q.soru, description: q.cevap }))}
  />

  <CallToAction
    title="Ücretsiz ön değerlendirme"
    subtitle="Tehlike sınıfınızı ve yükümlülüğünüzü çıkarıp size yazılı dönüyoruz."
    actions={[{ variant: 'primary', text: 'Teklif al', href: '/teklif-al/' }]}
  />
</Layout>
