---
import santiyePlanlama from '~/assets/images/santiye-is-guvenligi-planlama.jpg';
import degerlendirmeToplantisi from '~/assets/images/isyerinde-isg-degerlendirme-toplantisi.jpg';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Stats from '~/components/widgets/Stats.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import { site, isOrtagi, egitimSureleri } from '~/data/site';
import { hizmetler } from '~/data/hizmetler';
import { ilceler } from '~/data/ilceler';

const metadata = {
  title: 'OSGB Hizmeti ve Uzaktan İSG Eğitimi',
  ignoreTitleTemplate: false,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      { variant: 'primary', text: 'Yükümlülüğümü öğren', href: '/teklif-al/' },
      { text: 'Uzaktan İSG eğitimi', href: '/isg-egitimi/' },
    ]}
    image={{
      src: santiyePlanlama,
      alt: 'Şantiyede baret ve reflektif yelekle çalışan ekip',
    }}
  >
    <Fragment slot="title">
      İSG yükümlülüğünüz belli.<br />
      <span class="decoration-accent underline decoration-4 underline-offset-8">Belirsiz olan, ne kadara kapanacağı.</span>
    </Fragment>
    <Fragment slot="subtitle">
      Yükümlülüğünüz tehlike sınıfına ve çalışan sayısına göre değişir; aynı başlıkları
      sayan tekliflerin arasındaki fark da genelde buradan çıkar.{' '}
      <strong>Önce hangi yükümlülüğün size düştüğünü netleştiriyoruz.</strong>
    </Fragment>

    {/* Güven şeridi: ilk ekranda cevaplanması gereken üç soru — kim veriyor,
        nerede veriyor, hangi yetkiyle. Hepsi doğrulanabilir olgular. */}
    <Fragment slot="trust">
      <dl class="mt-9 grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-5 border-t border-gray-200 dark:border-slate-700 pt-6">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Saha hizmeti</dt>
          <dd class="mt-1 font-semibold text-heading">İstanbul · Kocaeli · Tekirdağ</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-muted">İSG eğitimi</dt>
          <dd class="mt-1 font-semibold text-heading">81 ilde planlanabilir</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Eğitim veren</dt>
          <dd class="mt-1 font-semibold text-heading">A sınıfı İSG uzmanı</dd>
        </div>
      </dl>
    </Fragment>
  </Hero>

  <Stats
    title="Yükümlülüğün üç sayısı"
    subtitle="Temel eğitim süreleri yönetmelikle sabittir; pazarlık konusu değildir."
    stats={egitimSureleri.map((e) => ({
      title: `${e.saat} saat`,
      amount: e.sinif,
    }))}
  />

  <Features
    id="hizmetler"
    tagline="Üç hizmet hattı"
    title="Ne yapıyoruz"
    subtitle="Saha hizmeti il sınırlıdır; danışmanlık, dokümantasyon ve eğitim değildir. İkisini bilerek ayrı yürütüyoruz."
    columns={3}
    items={[
      ...hizmetler.map((h) => ({
        title: h.ad,
        description: h.ozet,
        icon: h.kapsam === 'saha' ? 'tabler:shield-check' : 'tabler:file-text',
        callToAction: { text: 'Detay', href: `/hizmetler/${h.slug}/` },
      })),
      {
        title: 'Mobil sağlık aracı',
        description: 'İşe giriş ve periyodik muayeneler işyerinizde; odyometri, SFT, akciğer grafisi, EKG ve laboratuvar.',
        icon: 'tabler:ambulance',
        callToAction: { text: 'Detay', href: '/mobil-saglik-taramasi/' },
      },
      {
        title: 'Uzaktan İSG eğitimi',
        description: 'Zorunlu temel eğitim ve yenileme, 81 ilde. Katılım tutanağı ve Ek-2 belgesi.',
        icon: 'tabler:device-laptop',
        callToAction: { text: 'Detay', href: '/isg-egitimi/' },
      },
    ]}
  />

  <Steps
    title="Nasıl ilerliyor"
    items={[
      {
        title: 'Tehlike sınıfınızı çıkarıyoruz',
        description:
          'Sınıfı işveren seçmez; işyerinin NACE kodu belirler. Yükümlülüklerin neredeyse tamamı buna bağlı olduğu için ilk netleşmesi gereken şey budur.',
        icon: 'tabler:list-search',
      },
      {
        title: 'Yükümlülüğü ve maliyeti yazıyoruz',
        description:
          'Kaç saat uzman, kaç saat hekim, kaç saat eğitim. Kalem kalem, sonradan çıkan başlık olmadan.',
        icon: 'tabler:file-description',
      },
      {
        title: 'Sözleşme ve İSG-KATİP',
        description:
          'Görevlendirmeler İSG-KATİP üzerinden kayda geçer. Denetimde sorulan ilk şey budur.',
        icon: 'tabler:writing-sign',
      },
      {
        title: 'Saha ve eğitim takvimi',
        description:
          'Periyodik ziyaretler, mobil sağlık taraması ve çalışan eğitimleri planlanır.',
        icon: 'tabler:calendar-check',
      },
    ]}
    image={{
      src: degerlendirmeToplantisi,
      alt: 'Masa başında iş sağlığı ve güvenliği planlaması',
    }}
  />

  <Content
    isReversed
    title="Saha hizmetini kim veriyor"
    items={[
      { title: isOrtagi.ad, description: isOrtagi.adres, icon: 'tabler:building' },
      {
        title: 'Eğitimler doğrudan bizden',
        description: 'Uzaktan İSG eğitimlerini İSG uzmanı olarak doğrudan veriyoruz; bu hatta aracı yoktur.',
        icon: 'tabler:certificate',
      },
    ]}
  >
    <Fragment slot="content">
      <p>
        <strong>{site.name} bir OSGB değildir.</strong> OSGB, Çalışma ve Sosyal Güvenlik
        Bakanlığı tarafından yetkilendirilen bir yapıdır. Saha hizmetleri yetkili iş
        ortağımız tarafından verilir; süreci biz kurar ve yürütürüz.
      </p>
    </Fragment>
  </Content>

  <Features
    id="bolgeler"
    tagline="Saha kapsamı"
    title="Hizmet verdiğimiz ilçeler"
    subtitle="OSGB'ler kurulu oldukları il ve sınır komşusu illerde hizmet verebilir. Hizmet veremeyeceğimiz yerden talep toplamıyoruz."
    columns={3}
    items={ilceler.map((i) => ({
      title: `${i.ad} OSGB`,
      description: i.il,
      icon: 'tabler:map-pin',
      callToAction: { text: 'İlçe sayfası', href: `/osgb/${i.slug}/` },
    }))}
  />

  <FAQs
    schema
    title="Sık sorulanlar"
    items={[
      {
        title: 'OSGB hizmeti almak zorunlu mu?',
        description:
          'Zorunlu olan OSGB’den hizmet almak değil, iş güvenliği uzmanı ve işyeri hekimi görevlendirmektir. Bunları kendi bünyesinde istihdam edemeyen işyerleri hizmeti OSGB’den alır.',
      },
      {
        title: 'İSG eğitimi uzaktan verilebilir mi?',
        description:
          'Verilebilir, ama tamamı değil. Ek-1’in dördüncü konu başlığı tehlikeli ve çok tehlikeli işyerlerinde yüz yüze zorunludur; az tehlikeli sınıfta eğitimin tamamı uzaktan tamamlanabilir.',
      },
      {
        title: 'Başka şehirdeki çalışanlarıma eğitim verebilir misiniz?',
        description:
          'Evet. Saha OSGB hizmetinde il sınırı vardır, eğitimde yoktur. Türkiye’nin 81 ilindeki çalışanlara uzaktan eğitim verilebilir.',
      },
      {
        title: 'Tehlike sınıfımı nasıl öğrenirim?',
        description:
          'İşyerinin asıl faaliyetine karşılık gelen NACE kodu belirler. Teklif formunu doldurun, sınıfı ve buna bağlı yükümlülüğü biz çıkaralım.',
      },
    ]}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Teklif al', href: '/teklif-al/' }]}
    title="Önce yükümlülüğünüzü öğrenin"
    subtitle="Ne iş yaptığınızı, kaç kişi çalıştığınızı ve nerede olduğunuzu bilmemiz yeterli."
  />
</Layout>
