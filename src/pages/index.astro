---
import sahaDenetim from '~/assets/images/saha-denetim-ekibi.jpg';
import santiyePlanlama from '~/assets/images/santiye-is-guvenligi-planlama.jpg';
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import ReferansSeridi from '~/components/ReferansSeridi.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Stats from '~/components/widgets/Stats.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { site, egitimSureleri } from '~/data/site';
import { hizmetler } from '~/data/hizmetler';
import { sektorler } from '~/data/sektorler';
import { levhaSayisi } from '~/data/levhalar';
import { formSayisi } from '~/data/kutuphane';
import { katipReferanslari, katipReferansSayisi } from '~/data/katip-referanslar';

// Saha tecrübesi rakamları BURADA ÜRETİLİYOR, elle yazılmıyor: kaynak
// İSG-KATİP sözleşme listesinin kendisi. Liste değişince ana sayfa da
// değişir; "300+" gibi zamanla yalan olacak yuvarlak bir sayı yazılmıyor.
const benzersizIsYeri = new Set(katipReferanslari.map((k) => k.ad)).size;
const cokTehlikeli = katipReferanslari.filter((k) => k.sinif === 'cok').length;
const tehlikeli = katipReferanslari.filter((k) => k.sinif === 'teh').length;

const metadata = {
  title: 'OSGB Hizmeti ve Uzaktan İSG Eğitimi',
  ignoreTitleTemplate: false,
};

// Ana sayfadaki sektör vitrini: şantiye tek başına ne yaptığımızı anlatmıyor —
// üretim, metal, kimya ve lojistik de aynı ölçüde bizim işimiz.
const vitrinSlug = ['insaat', 'fabrika-uretim', 'metal-kaynak', 'kimya-boya', 'lojistik-depo', 'gida-restoran'];
const vitrin = vitrinSlug
  .map((slug) => sektorler.find((x) => x.slug === slug))
  .filter((x): x is NonNullable<typeof x> => Boolean(x));

const sektorGorselleri = import.meta.glob<{ default: ImageMetadata }>('~/assets/images/sektor-*.jpg', {
  eager: true,
});
const sektorGorseli = (dosya?: string) =>
  dosya ? sektorGorselleri[`/src/assets/images/${dosya}`]?.default : undefined;
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      { variant: 'primary', text: 'Yükümlülüğümü hesapla', href: '/araclar/isg-yukumluluk-hesaplama/' },
      { text: 'Teklif al', href: '/teklif-al/' },
    ]}
    image={{
      src: sahaDenetim,
      alt: 'Şantiyede baret ve reflektif yelekle saha denetimi yapan ekip',
    }}
  >
    <Fragment slot="title">
      İş güvenliği hizmeti artık<br />
      <span class="decoration-accent underline decoration-4 underline-offset-8">her iş yeri için zorunlu.</span>
    </Fragment>
    <Fragment slot="subtitle">
      Kamu kurumlarına ve az tehlikeli sınıftaki küçük iş yerlerine tanınan süre
      31 Aralık 2024'te doldu. Bugün bir çalışanı olan her iş yeri iş güvenliği uzmanı
      ve işyeri hekimi görevlendirmek zorunda.{' '}
      <strong>Soru artık "zorunlu mu" değil: size kaç saat ve hangi hizmet düşüyor?</strong>
      {' '}İki dakikada çıkaralım.
    </Fragment>

    {/* Güven şeridi: ilk ekranda cevaplanması gereken üç soru — kim veriyor,
        nerede veriyor, hangi yetkiyle. Hepsi doğrulanabilir olgular. */}
    <Fragment slot="trust">
      <dl class="mt-9 grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-5 border-t border-gray-200 dark:border-slate-700 pt-6">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Saha hizmeti</dt>
          <dd class="mt-1 font-semibold text-heading">İstanbul · Kocaeli · Tekirdağ</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-muted">İSG eğitimi</dt>
          <dd class="mt-1 font-semibold text-heading">81 ilde planlanabilir</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Eğitim veren</dt>
          <dd class="mt-1 font-semibold text-heading">A sınıfı İSG uzmanı</dd>
        </div>
      </dl>
    </Fragment>
  </Hero>

  <ReferansSeridi />

  {/*
    Saha tecrübesi rakamları. Bu sitenin en güçlü güven unsuru buydu ama
    yalnız referanslar sayfasının içinde duruyordu; ana sayfaya gelen
    "bu firma benim ölçeğimi kaldırır mı" sorusu cevapsız kalıyordu.
    Rakamlar İSG-KATİP sözleşme kaydından üretiliyor, beyan değil.
  */}
  <section class="border-y border-gray-200 bg-gray-50 dark:border-slate-800 dark:bg-slate-900/40">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-12">
      <h2 class="text-center text-2xl font-bold text-heading md:text-3xl">Rakamlarla saha tecrübesi</h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-muted">
        Aşağıdaki sayılar beyan değil: Çalışma ve Sosyal Güvenlik Bakanlığı'nın kayıt sistemi
        İSG-KATİP'te adımıza tanımlanmış hizmet sözleşmelerinden çıkarıldı.
      </p>
      <dl class="mt-8 grid grid-cols-2 gap-6 text-center md:grid-cols-4">
        <div>
          <dt class="text-3xl font-bold tabular-nums text-heading md:text-4xl">{benzersizIsYeri}</dt>
          <dd class="mt-1 text-sm text-muted">ayrı iş yeri</dd>
        </div>
        <div>
          <dt class="text-3xl font-bold tabular-nums text-heading md:text-4xl">{cokTehlikeli}</dt>
          <dd class="mt-1 text-sm text-muted">çok tehlikeli sınıf</dd>
        </div>
        <div>
          <dt class="text-3xl font-bold tabular-nums text-heading md:text-4xl">{tehlikeli}</dt>
          <dd class="mt-1 text-sm text-muted">tehlikeli sınıf</dd>
        </div>
        <div>
          <dt class="text-3xl font-bold text-heading md:text-4xl">A</dt>
          <dd class="mt-1 text-sm text-muted">sınıfı İSG uzmanı</dd>
        </div>
      </dl>
      <p class="mt-6 text-center text-sm">
        <a class="font-medium underline underline-offset-4 hover:no-underline" href="/referanslar/">
          {katipReferansSayisi} sözleşmenin tamamını iş yeri adıyla görün →
        </a>
      </p>
    </div>
  </section>

  <Stats
    title="Çalışan eğitimi kaç saat?"
    subtitle="İşyerinizin tehlike sınıfı, her çalışanın alması gereken temel İSG eğitiminin süresini belirler. Bu süreler yönetmelikle sabittir."
    stats={egitimSureleri.map((e) => ({
      amount: `${e.saat}`,
      title: `${e.sinif} · ders saati`,
    }))}
  />

  {/* Sektör vitrini: hangi ortamlarda çalıştığımızı tek bakışta göstermek için. */}
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-7">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-primary mb-1.5">Sektörler</p>
        <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading tracking-tight">
          Şantiyede de çalışıyoruz, üretim bandında da
        </h2>
      </div>
      <a href="/sektorler/" class="text-sm font-semibold text-primary hover:underline">
        {sektorler.length} sektörün tamamı →
      </a>
    </div>
    <ul class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {
        vitrin.map((s) => {
          const gorsel = sektorGorseli(s.gorsel);
          return (
            <li>
              <a
                href={`/sektorler/${s.slug}/`}
                class="group relative block overflow-hidden rounded-2xl aspect-[4/3] ring-1 ring-gray-200 dark:ring-slate-700"
              >
                {gorsel && (
                  <Image
                    src={gorsel}
                    alt={s.ad}
                    widths={[400, 700]}
                    sizes="(max-width: 768px) 50vw, 33vw"
                    class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                    loading="lazy"
                  />
                )}
                <span class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent" />
                <span class="absolute inset-x-0 bottom-0 p-4">
                  <span class="block font-bold text-white text-balance leading-snug">{s.ad}</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <Features
    id="hizmetler"
    tagline="Hizmetlerimiz"
    title="Hangi işleri üstleniyoruz"
    subtitle="İş sağlığı ve güvenliğinde ihtiyacınız olan her başlık tek elden. Saha ekibinden eğitime, ölçümden dokümantasyona."
    columns={3}
    items={[
      ...hizmetler.map((h) => ({
        title: h.ad,
        description: h.ozet,
        icon: h.kapsam === 'saha' ? 'tabler:shield-check' : 'tabler:file-text',
        callToAction: { text: 'Detay', href: `/hizmetler/${h.slug}/` },
      })),
      {
        title: 'Mobil sağlık aracı',
        description: 'İşe giriş ve periyodik muayeneler işyerinizde; odyometri, SFT, akciğer grafisi, EKG ve laboratuvar.',
        icon: 'tabler:ambulance',
        callToAction: { text: 'Detay', href: '/mobil-saglik-taramasi/' },
      },
      {
        title: 'Uzaktan İSG eğitimi',
        description: 'Zorunlu temel eğitim ve yenileme, 81 ilde. Katılım tutanağı ve Ek-2 belgesi.',
        icon: 'tabler:device-laptop',
        callToAction: { text: 'Detay', href: '/isg-egitimi/' },
      },
    ]}
  />

  {/*
    "Neden biz" bölümü. Maddeler pazarlama sıfatı değil, sitenin başka
    yerlerinde zaten kanıtı olan şeyler: kütüphane sayısı, hizmet listesi,
    yetki devri açıklaması, mevzuat tarihleri. Kanıtı olmayan iddia girmiyor.
  */}
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-14">
    <h2 class="text-2xl font-bold text-heading md:text-3xl">Neden Dijital OSGB</h2>
    <p class="mt-3 max-w-2xl text-muted">
      İş sağlığı ve güvenliği birden fazla tedarikçiye bölündüğünde takvim tutmuyor: eğitim
      bir yerde, ölçüm başka yerde, periyodik kontrol üçüncü yerde kalıyor. Biz bu süreci
      tek noktadan yürütüyoruz.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          {
            baslik: 'Tek noktadan yönetim',
            metin: `Uzmanlık, hekimlik, ölçüm, periyodik kontrol, eğitim ve dokümantasyon ${hizmetler.length} ayrı hizmet başlığı altında aynı ekip tarafından planlanıyor.`,
          },
          {
            baslik: 'Her tehlike sınıfında saha',
            metin: `İSG-KATİP kaydına göre ${cokTehlikeli} çok tehlikeli ve ${tehlikeli} tehlikeli sınıf iş yeri. Ofisten madene aynı mevzuat, farklı uygulama.`,
          },
          {
            baslik: 'Yetki sınırları açık',
            metin:
              'Saha OSGB hizmeti yetki belgeli iş ortağımız üzerinden yürüyor ve bunu sayfalarda açıkça yazıyoruz. Veremeyeceğimiz hizmeti taahhüt etmiyoruz.',
          },
          {
            baslik: 'Mevzuat takibi',
            metin:
              'Sitedeki süreler ve yükümlülükler yönetmelik değiştiğinde güncelleniyor; 2 Nisan 2026 tarihli yeni eğitim yönetmeliği sayfalara aynı ay işlendi.',
          },
          {
            baslik: 'Dokümantasyon hazır geliyor',
            metin: `${formSayisi} form şablonu ve ${levhaSayisi} güvenlik levhası ücretsiz, A4 PDF olarak indirilebiliyor. Hizmet alan iş yerine dosya düzeniyle birlikte teslim ediliyor.`,
          },
          {
            baslik: 'Uzaktan çalışabilen kısım uzaktan',
            metin:
              'Az tehlikeli sınıfta eğitimin tamamı uzaktan verilebiliyor; saha gerektiren işler için İstanbul, Kocaeli ve Tekirdağ\'da yerinde hizmet var.',
          },
        ].map((k) => (
          <div class="rounded-lg border border-gray-200 p-5 dark:border-slate-700">
            <h3 class="font-semibold text-heading">{k.baslik}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{k.metin}</p>
          </div>
        ))
      }
    </div>
  </section>

  <Steps
    title="Başlangıçtan ilk saha ziyaretine"
    items={[
      {
        title: 'Tehlike sınıfınızı çıkarıyoruz',
        description:
          'Sınıfı işveren seçmez; işyerinin NACE kodu belirler. Yükümlülüklerin neredeyse tamamı buna bağlı olduğu için ilk netleşmesi gereken şey budur.',
        icon: 'tabler:list-search',
      },
      {
        title: 'Yükümlülüğü ve maliyeti yazıyoruz',
        description:
          'Kaç saat uzman, kaç saat hekim, kaç saat eğitim. Kalem kalem, sonradan çıkan başlık olmadan.',
        icon: 'tabler:file-description',
      },
      {
        title: 'Sözleşme ve İSG-KATİP',
        description:
          'Görevlendirmeler İSG-KATİP üzerinden kayda geçer. Denetimde sorulan ilk şey budur.',
        icon: 'tabler:writing-sign',
      },
      {
        title: 'Saha ve eğitim takvimi',
        description:
          'Periyodik ziyaretler, mobil sağlık taraması ve çalışan eğitimleri planlanır.',
        icon: 'tabler:calendar-check',
      },
    ]}
    image={{
      src: santiyePlanlama,
      alt: 'Şantiyede iş güvenliği önlemleriyle yürüyen çalışma',
    }}
  />



  {/* Ücretsiz kaynaklar: siteyi bir kez gelinen teklif sayfası olmaktan çıkarıp
      geri dönülen bir yere çeviren bölüm. */}
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <div class="rounded-3xl bg-gray-50 dark:bg-slate-900/60 ring-1 ring-gray-200 dark:ring-slate-700 p-6 md:p-10">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary mb-1.5">Ücretsiz</p>
      <h2 class="text-2xl md:text-3xl font-bold font-heading text-heading tracking-tight mb-3">İSG kütüphanesi</h2>
      <p class="text-muted max-w-2xl mb-8">
        Teklif almasanız da işinize yarayacak şeyler: basmaya hazır levhalar, boş form
        şablonları, mevzuat dizini ve hesaplama araçları. Kayıt yok, e-posta yok.
      </p>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <li>
          <a href="/isg-kutuphanesi/levhalar/" class="group block h-full rounded-2xl bg-white dark:bg-slate-900 ring-1 ring-gray-200 dark:ring-slate-700 p-5 transition hover:ring-primary/40">
            <span class="block text-2xl font-bold text-heading tabular-nums">{levhaSayisi}</span>
            <span class="block font-semibold text-heading mt-0.5 group-hover:text-primary transition">Güvenlik levhası</span>
            <span class="block text-sm text-muted mt-1">A4 PDF, indir ve as.</span>
          </a>
        </li>
        <li>
          <a href="/isg-kutuphanesi/formlar/" class="group block h-full rounded-2xl bg-white dark:bg-slate-900 ring-1 ring-gray-200 dark:ring-slate-700 p-5 transition hover:ring-primary/40">
            <span class="block text-2xl font-bold text-heading tabular-nums">{formSayisi}</span>
            <span class="block font-semibold text-heading mt-0.5 group-hover:text-primary transition">Form şablonu</span>
            <span class="block text-sm text-muted mt-1">Tutanak, zimmet, rapor.</span>
          </a>
        </li>
        <li>
          <a href="/araclar/tehlike-sinifi-sorgulama/" class="group block h-full rounded-2xl bg-white dark:bg-slate-900 ring-1 ring-gray-200 dark:ring-slate-700 p-5 transition hover:ring-primary/40">
            <span class="block text-2xl font-bold text-heading tabular-nums">2114</span>
            <span class="block font-semibold text-heading mt-0.5 group-hover:text-primary transition">NACE kodu</span>
            <span class="block text-sm text-muted mt-1">Tehlike sınıfı sorgulama.</span>
          </a>
        </li>
        <li>
          <a href="/isg-kutuphanesi/mevzuat/" class="group block h-full rounded-2xl bg-white dark:bg-slate-900 ring-1 ring-gray-200 dark:ring-slate-700 p-5 transition hover:ring-primary/40">
            <span class="block text-2xl font-bold text-heading tabular-nums">15</span>
            <span class="block font-semibold text-heading mt-0.5 group-hover:text-primary transition">Mevzuat başlığı</span>
            <span class="block text-sm text-muted mt-1">Hangi kural nerede yazıyor.</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <FAQs
    schema
    title="Merak edilenler"
    subtitle="En çok sorulanlar burada. Aradığınızı bulamazsanız 45 sorunun tamamı SSS sayfasında."
    items={[
      {
        title: 'OSGB hizmeti almak zorunlu mu?',
        description:
          'Zorunlu olan OSGB’den hizmet almak değil, iş güvenliği uzmanı ve işyeri hekimi görevlendirmektir. Bunları kendi bünyesinde istihdam edemeyen işyerleri hizmeti OSGB’den alır.',
      },
      {
        title: 'İSG eğitimi uzaktan verilebilir mi?',
        description:
          'Verilebilir, ama tamamı değil. Ek-1’in dördüncü konu başlığı tehlikeli ve çok tehlikeli işyerlerinde yüz yüze zorunludur; az tehlikeli sınıfta eğitimin tamamı uzaktan tamamlanabilir.',
      },
      {
        title: 'Başka şehirdeki çalışanlarıma eğitim verebilir misiniz?',
        description:
          'Evet. Saha OSGB hizmetinde il sınırı vardır, eğitimde yoktur. Türkiye’nin 81 ilindeki çalışanlara uzaktan eğitim verilebilir.',
      },
      {
        title: 'Tehlike sınıfımı nasıl öğrenirim?',
        description:
          'İşyerinin asıl faaliyetine karşılık gelen NACE kodu belirler. Teklif formunu doldurun, sınıfı ve buna bağlı yükümlülüğü biz çıkaralım.',
      },
    ]}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Teklif al', href: '/teklif-al/' }]}
    title="Size ne düştüğünü birlikte çıkaralım"
    subtitle="Üç bilgi yeterli: ne iş yaptığınız, kaç çalışanınız olduğu ve nerede olduğunuz. Gerisini biz hesaplayıp yazılı gönderiyoruz."
  />
</Layout>
