---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site, egitimSureleri } from '~/data/site';
import { illerSayfali } from '~/data/iller';

export function getStaticPaths() {
  return illerSayfali.map((i) => ({ params: { il: i.slug }, props: { il: i } }));
}
const { il } = Astro.props;

const metadata = {
  title: `${il.ad} Uzaktan İSG Eğitimi`,
  description:
    `${il.ad} işyerleri için zorunlu temel İSG eğitimi uzaktan verilir. ` +
    `Tehlike sınıfına göre 8, 12 veya 16 ders saati; katılım tutanağı ve Ek-2 belgesi düzenlenir.`,
};

const structuredData = [{
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `${il.ad} için uzaktan İSG eğitimi`,
  inLanguage: 'tr',
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', location: { '@type': 'AdministrativeArea', name: il.ad } },
}];
---
<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />
  <HeroText
    tagline="Uzaktan eğitim"
    title={`${il.ad} için İSG eğitimi`}
    subtitle={il.sektor}
    actions={[{ variant: 'primary', text: `${il.ad} için teklif al`, href: '/teklif-al/' }]}
  />
  <Features
    title="Süre ve uzaktan verilebilirlik"
    columns={3}
    items={egitimSureleri.map((e) => ({ title: e.sinif, description: `${e.saat} ders saati. ${e.uzaktan}.`, icon: 'tabler:clock' }))}
  />
  <Content
    title={`${il.ad}'da eğitim nasıl planlanıyor`}
    items={il.egitimNotu.map((n) => ({ description: n, icon: 'tabler:calendar-event' }))}
  >
    <Fragment slot="content">
      <p>
        Eğitim takvimi işyerinin çalışma düzenine göre kurulur. Aşağıdakiler
        {' '}{il.ad} işyerlerinde planlamayı en çok etkileyen noktalar.
      </p>
    </Fragment>
  </Content>

  <FAQs
    schema
    title={`${il.ad} için sık sorulanlar`}
    items={[
      {
        title: `${il.ad}'da OSGB hizmeti de veriyor musunuz?`,
        description: site.hizmetIlleri.includes(il.ad)
          ? `Evet. ${il.ad} saha hizmeti kapsamımızda; iş güvenliği uzmanı ve işyeri hekimi görevlendirmesi yapılabiliyor.`
          : `Hayır. OSGB'ler kurulu oldukları il ve sınır komşusu illerde hizmet verebilir; saha kapsamımız ${site.hizmetIlleri.join(', ')} ile sınırlı. ${il.ad}'da eğitim, danışmanlık ve dokümantasyon hizmeti veriyoruz.`,
      },
      {
        title: 'Eğitim sonunda hangi belge düzenleniyor?',
        description:
          'Katılım tutanağı ve yönetmeliğin Ek-2\'sindeki forma uygun temel eğitim belgesi. Belgeler çalışanın özlük dosyasında saklanır.',
      },
      {
        title: 'Eğitimin tamamı uzaktan olabilir mi?',
        description:
          'Az tehlikeli işyerlerinde evet. Tehlikeli ve çok tehlikeli işyerlerinde Ek-1\'in dördüncü konu başlığı yüz yüze yapılır; kalan bölüm uzaktan tamamlanır.',
      },
    ]}
  />

  <CallToAction
    title="Eğitimde il sınırı yok"
    subtitle={`${il.ad} saha hizmeti kapsamımız dışında olsa bile çalışanlarınıza uzaktan eğitim verebiliriz.`}
    actions={[{ variant: 'primary', text: 'Teklif al', href: '/teklif-al/' }]}
  />
</Layout>
