---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site, egitimSureleri } from '~/data/site';
import { illerSayfali, tumIller } from '~/data/iller';

const metadata = {
  title: 'Uzaktan İSG Eğitimi — Türkiye Geneli',
  description: "Çalışanların zorunlu temel İSG eğitimi, 81 ilde uzaktan. Az tehlikeli 8, tehlikeli 12, çok tehlikeli 16 ders saati.",
};

const sss = [
  { title: 'Uzaktan İSG eğitimi geçerli mi?', description: 'Evet. Yönetmelik uzaktan eğitimi tanıyor. Ek-1’deki ilk üç konu başlığı her işyerinde uzaktan verilebilir; dördüncü başlık tehlikeli ve çok tehlikeli işyerlerinde yüz yüze zorunludur.' },
  { title: 'Eğitim kaç saat olmak zorunda?', description: 'Tehlike sınıfına göre: az tehlikeli 8, tehlikeli 12, çok tehlikeli 16 ders saati. Bu süreler yönetmelikle sabittir.' },
  { title: 'Eğitim sonunda hangi belge düzenleniyor?', description: 'Katılım tutanağı ve yönetmeliğin Ek-2’sindeki forma uygun temel eğitim belgesi. Belgeler çalışanın özlük dosyasında saklanır.' },
  { title: 'Başka şehirdeki çalışanlarıma eğitim verebilir misiniz?', description: 'Evet. Saha OSGB hizmetinde il sınırı vardır, eğitimde yoktur. 81 ildeki çalışanlara uzaktan eğitim verilebilir.' },
  { title: 'Eğitimi kim veriyor?', description: 'Eğitimler İSG uzmanı tarafından doğrudan verilir. Bu hizmette aracı yoktur.' },
];

const structuredData = [{
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Çalışanların Temel İş Sağlığı ve Güvenliği Eğitimi',
  description: '6331 sayılı Kanun kapsamında zorunlu temel İSG eğitimi.',
  inLanguage: 'tr',
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  hasCourseInstance: egitimSureleri.map((e) => ({
    '@type': 'CourseInstance',
    name: `${e.sinif} işyerleri için temel İSG eğitimi`,
    courseMode: 'online',
    courseWorkload: `PT${e.saat}H`,
  })),
}];
---
<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />
  <HeroText
    tagline="81 ilde geçerli"
    title="Uzaktan İSG eğitimi"
    subtitle="Saha OSGB hizmetinde il sınırı vardır; eğitimde yoktur. Çalışanlarınız Türkiye'nin neresinde olursa olsun zorunlu temel eğitimi uzaktan tamamlayabilir."
    actions={[{ variant: 'primary', text: 'Eğitim teklifi al', href: '/teklif-al/' }]}
  />

  <Stats
    title="Temel eğitim süreleri"
    subtitle="Yönetmelikle sabit; pazarlık konusu değildir."
    stats={egitimSureleri.map((e) => ({ title: `${e.saat} saat`, amount: e.sinif }))}
  />

  <Features
    title="Neyin uzaktan verilebildiği sınıfa bağlı"
    columns={3}
    items={egitimSureleri.map((e) => ({
      title: e.sinif,
      description: `${e.saat} ders saati. ${e.uzaktan}.`,
      icon: 'tabler:device-laptop',
    }))}
  />

  <FAQs schema title="Sık sorulanlar" items={sss} />

  <Features
    title="İllere göre"
    subtitle="Aşağıdaki iller için ayrı sayfa var; eğitim hizmetimiz 81 ilin tamamını kapsıyor."
    columns={3}
    items={illerSayfali.map((i) => ({
      title: i.ad,
      description: i.sektor.slice(0, 90) + '…',
      icon: 'tabler:map-pin',
      callToAction: { text: 'Detay', href: `/isg-egitimi/${i.slug}/` },
    }))}
  />

  <CallToAction
    title="Hizmet verilen iller"
    subtitle={tumIller.join(' · ')}
    actions={[{ variant: 'primary', text: 'Teklif al', href: '/teklif-al/' }]}
  />
</Layout>
