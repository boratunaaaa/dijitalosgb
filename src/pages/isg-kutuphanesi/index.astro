---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site } from '~/data/site';
import { levhaSayisi } from '~/data/levhalar';
import { formSayisi } from '~/data/kutuphane';
import { mevzuatListesi } from '~/data/mevzuat-listesi';
import { yaziSayisi } from '~/data/blog';
import { soruSayisi } from '~/data/sss';

const metadata = {
  title: 'İSG Kütüphanesi — Levhalar, Formlar, Mevzuat ve Araçlar',
  description: `İş sağlığı ve güvenliğiyle ilgili her şey tek yerde: ${levhaSayisi} basılabilir levha, ${formSayisi} form şablonu, mevzuat dizini, hesaplama araçları. Ücretsiz.`,
};

const sayfaUrl = `${site.url}/isg-kutuphanesi/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'İSG kütüphanesi', item: sayfaUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: metadata.title,
    description: metadata.description,
    url: sayfaUrl,
    inLanguage: 'tr-TR',
    isAccessibleForFree: true,
  },
];

const raflar = [
  {
    href: '/isg-kutuphanesi/levhalar/',
    baslik: 'Güvenlik levhaları',
    adet: `${levhaSayisi} levha`,
    aciklama:
      'Baret tak, acil çıkış, yangın söndürücü, kaygan zemin… A4’e basmaya hazır PDF. İndirin, çıktı alın, asın.',
    renk: 'from-blue-500/10 to-blue-500/0 ring-blue-500/20',
  },
  {
    href: '/isg-kutuphanesi/formlar/',
    baslik: 'Form ve tutanak şablonları',
    adet: `${formSayisi} şablon`,
    aciklama:
      'Ramak kala bildirimi, KKD zimmeti, eğitim tutanağı, tatbikat raporu, kaza inceleme formu, saha denetim listesi.',
    renk: 'from-emerald-500/10 to-emerald-500/0 ring-emerald-500/20',
  },
  {
    href: '/isg-kutuphanesi/ornek-dokumanlar/',
    baslik: 'Örnek dokümanlar',
    adet: 'Risk analizi + ADEP',
    aciklama:
      'Bir risk değerlendirmesi satırı gerçekte neye benzer, skor nasıl çıkar, acil durum planı hangi bölümlerden oluşur.',
    renk: 'from-orange-500/10 to-orange-500/0 ring-orange-500/20',
  },
  {
    href: '/isg-kutuphanesi/mevzuat/',
    baslik: 'Mevzuat dizini',
    adet: `${mevzuatListesi.length} düzenleme`,
    aciklama:
      'Hangi kural hangi yönetmelikte? 6331 sayılı Kanun PDF olarak burada; yönetmelikler güncel resmî metne bağlı.',
    renk: 'from-amber-500/10 to-amber-500/0 ring-amber-500/20',
  },
  {
    href: '/araclar/',
    baslik: 'Hesaplama ve sorgulama araçları',
    adet: '2 araç',
    aciklama:
      'NACE koduyla tehlike sınıfı sorgulama ve çalışan sayısına göre uzman–hekim süresi hesaplama. Anında sonuç.',
    renk: 'from-violet-500/10 to-violet-500/0 ring-violet-500/20',
  },
  {
    href: '/blog/',
    baslik: 'Rehber yazıları',
    adet: `${yaziSayisi} yazı`,
    aciklama:
      'Mevzuatın ne dediğini ve sahada nasıl karşılık bulduğunu anlatan yazılar. Her yazı bir soruya cevap veriyor.',
    renk: 'from-rose-500/10 to-rose-500/0 ring-rose-500/20',
  },
  {
    href: '/sss/',
    baslik: 'Sıkça sorulan sorular',
    adet: `${soruSayisi} soru`,
    aciklama:
      'İSG konusunda en çok aranan soruların kısa ve doğrudan cevapları; hepsi mevzuat kaynağıyla.',
    renk: 'from-cyan-500/10 to-cyan-500/0 ring-cyan-500/20',
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <nav aria-label="Konum" class="text-sm text-muted mb-6">
      <a href="/" class="hover:underline">Ana sayfa</a>
      <span class="mx-1.5">/</span>
      <span class="text-default">İSG kütüphanesi</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-bold font-heading text-heading tracking-tight mb-4">
      İSG kütüphanesi
    </h1>
    <p class="text-lg text-muted max-w-3xl mb-3">
      İş sağlığı ve güvenliğiyle ilgili ihtiyacınız olan şeyleri tek yerde topladık:
      basılabilir levhalar, boş form şablonları, mevzuat dizini ve hesaplama araçları.
    </p>
    <p class="text-muted max-w-3xl mb-10">
      Hepsi ücretsiz ve kayıt istemiyor. Niye? Çünkü bu işin büyük kısmı bilgi
      eksikliğinden aksıyor — formu bulamadığı için kayıt tutmayan, hangi levhayı
      asacağını bilmediği için hiç asmayan çok iş yeri var. Teklif almak
      isteyeceğiniz gün zaten burayı hatırlarsınız.
    </p>

    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        raflar.map((r) => (
          <li>
            <a
              href={r.href}
              class:list={[
                'group h-full flex flex-col rounded-2xl bg-gradient-to-b ring-1 p-6 transition hover:-translate-y-0.5 hover:shadow-lg motion-reduce:hover:translate-y-0',
                r.renk,
              ]}
            >
              <span class="text-xs font-semibold uppercase tracking-wider text-muted mb-2">{r.adet}</span>
              <h2 class="text-xl font-bold font-heading text-heading mb-2 group-hover:underline">{r.baslik}</h2>
              <p class="text-sm text-muted flex-1">{r.aciklama}</p>
              <span class="mt-4 text-sm font-semibold text-primary">Aç →</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-14 rounded-2xl bg-primary/5 dark:bg-primary/10 ring-1 ring-primary/20 p-6 md:p-8">
      <h2 class="text-xl font-bold font-heading text-heading mb-2">Kütüphanede olmasını istediğiniz bir şey var mı?</h2>
      <p class="text-muted mb-5 max-w-2xl">
        Eksik bulduğunuz bir form, levha veya konu varsa yazın. Sık istenenleri
        hazırlayıp buraya ekliyoruz.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href="/teklif-al/"
          class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 font-semibold text-white hover:opacity-90 transition"
        >
          İstek gönder
        </a>
        <a
          href={`https://wa.me/${site.whatsapp}`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center rounded-full ring-1 ring-gray-300 dark:ring-slate-600 px-6 py-3 font-semibold text-default hover:bg-gray-50 dark:hover:bg-slate-800 transition"
        >
          WhatsApp'tan yaz
        </a>
      </div>
    </div>
  </section>
</Layout>
