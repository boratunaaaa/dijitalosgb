---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site } from '~/data/site';
import { mevzuatListesi } from '~/data/mevzuat-listesi';

const metadata = {
  title: 'İSG Mevzuatı — Kanun, Yönetmelik ve Tebliğ Dizini',
  description:
    '6331 sayılı Kanun ve İSG yönetmeliklerinin ne düzenlediğini anlatan dizin. Kanun metni PDF olarak sitede, diğerleri resmî kaynakta.',
};

const sayfaUrl = `${site.url}/isg-kutuphanesi/mevzuat/`;
const turAdi = { kanun: 'Kanun', yonetmelik: 'Yönetmelik', teblig: 'Tebliğ' } as const;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'İSG kütüphanesi', item: `${site.url}/isg-kutuphanesi/` },
    { '@type': 'ListItem', position: 3, name: 'Mevzuat', item: sayfaUrl },
  ],
};

const aramaUrl = (ad: string) => `https://www.mevzuat.gov.tr/?searchText=${encodeURIComponent(ad)}`;
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <nav aria-label="Konum" class="text-sm text-muted mb-6">
      <a href="/" class="hover:underline">Ana sayfa</a>
      <span class="mx-1.5">/</span>
      <a href="/isg-kutuphanesi/" class="hover:underline">İSG kütüphanesi</a>
      <span class="mx-1.5">/</span>
      <span class="text-default">Mevzuat</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-bold font-heading text-heading tracking-tight mb-4">
      İSG mevzuat dizini
    </h1>
    <p class="text-lg text-muted max-w-3xl mb-4">
      Hangi düzenlemenin neyi anlattığını bir arada görün. Aradığınız kural çoğu
      zaman kanunda değil, ona bağlı yönetmeliktedir.
    </p>
    <p class="text-muted max-w-3xl mb-10">
      Yönetmelik metinlerinin kopyasını burada tutmuyoruz: mevzuat değişiyor ve
      eskimiş bir kopya, hiç olmamasından daha zararlı. Bağlantılar metnin güncel
      hâlini tutan resmî kaynağa gider.
    </p>

    <ul class="space-y-3">
      {
        mevzuatListesi.map((m) => (
          <li class="rounded-2xl ring-1 ring-gray-200 dark:ring-slate-700 bg-white dark:bg-slate-900 p-5 sm:p-6">
            <div class="flex flex-wrap items-center gap-2.5 mb-2">
              <span class="rounded-full bg-primary/10 text-primary px-2.5 py-0.5 text-xs font-semibold">
                {turAdi[m.tur]}
              </span>
              {m.dosya && (
                <span class="rounded-full bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300 px-2.5 py-0.5 text-xs font-semibold">
                  PDF sitede
                </span>
              )}
            </div>
            <h2 class="font-bold text-heading leading-snug mb-2 text-balance">{m.ad}</h2>
            <p class="text-sm text-muted mb-4">{m.konu}</p>
            <a
              href={m.dosya ?? aramaUrl(m.ad)}
              target={m.dosya ? undefined : '_blank'}
              rel={m.dosya ? undefined : 'noopener'}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline"
            >
              {m.dosya ? 'PDF olarak aç' : 'Resmî metne git'}
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
