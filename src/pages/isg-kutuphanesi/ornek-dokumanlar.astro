---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site } from '~/data/site';
import { matris, ornekRiskSatirlari, ornekAdepBolumleri } from '~/data/ornek-dokumanlar';

const metadata = {
  title: 'Örnek Risk Değerlendirmesi ve Acil Durum Planı',
  description:
    'Risk değerlendirmesi satırı gerçekte neye benzer? 5x5 matris, örnek risk satırları, skor hesabı ve acil durum eylem planının bölüm bölüm iskeleti.',
};

const sayfaUrl = `${site.url}/isg-kutuphanesi/ornek-dokumanlar/`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'İSG kütüphanesi', item: `${site.url}/isg-kutuphanesi/` },
    { '@type': 'ListItem', position: 3, name: 'Örnek dokümanlar', item: sayfaUrl },
  ],
};

/** Skor bandını puandan bul — tabloda renk ve etiket için. */
const bant = (puan: number) => matris.bantlar.find((b) => puan >= b.alt && puan <= b.ust)!;
const bantRengi: Record<string, string> = {
  yesil: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-500/15 dark:text-emerald-300',
  acikyesil: 'bg-lime-100 text-lime-800 dark:bg-lime-500/15 dark:text-lime-300',
  sari: 'bg-amber-100 text-amber-800 dark:bg-amber-500/15 dark:text-amber-300',
  turuncu: 'bg-orange-100 text-orange-800 dark:bg-orange-500/15 dark:text-orange-300',
  kirmizi: 'bg-rose-100 text-rose-800 dark:bg-rose-500/15 dark:text-rose-300',
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <nav aria-label="Konum" class="text-sm text-muted mb-6">
      <a href="/" class="hover:underline">Ana sayfa</a>
      <span class="mx-1.5">/</span>
      <a href="/isg-kutuphanesi/" class="hover:underline">İSG kütüphanesi</a>
      <span class="mx-1.5">/</span>
      <span class="text-default">Örnek dokümanlar</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-bold font-heading text-heading tracking-tight mb-4">
      Örnek risk değerlendirmesi ve acil durum planı
    </h1>
    <p class="text-lg text-muted max-w-3xl mb-4">
      İki dokümanın da gerçekte neye benzediğini gösteriyoruz: bir risk satırında
      hangi sütuna ne yazılır, skor nasıl çıkar, plan hangi bölümlerden oluşur.
    </p>
    <div class="rounded-2xl bg-amber-50 dark:bg-amber-500/10 ring-1 ring-amber-300/50 dark:ring-amber-500/25 p-5 max-w-3xl mb-12">
      <p class="text-sm text-amber-900 dark:text-amber-200 leading-relaxed">
        <strong>Bu bir şablon değil, örnektir.</strong> Aşağıdaki satırlar tipik bir
        metal işleme atölyesi üzerinden yazıldı; hiçbir iş yerinin gerçek dosyasından
        alınmadı. İndirip adını değiştirmek işe yaramaz: risk değerlendirmesi sizin
        makinenize, vardiyanıza ve çalışanınıza bakan bir kayıttır — denetimde de
        ilk bakılan şey, sahadaki durumla kâğıdın birbirini tutup tutmadığıdır.
      </p>
    </div>

    <h2 class="text-2xl font-bold font-heading text-heading mb-3">Skor nasıl çıkıyor</h2>
    <p class="text-muted max-w-3xl mb-6">
      En yaygın yöntem {matris.ad}: bir tehlikenin gerçekleşme <strong>olasılığı</strong> ile
      gerçekleştiğinde doğuracağı <strong>şiddet</strong> çarpılır. Çıkan puan, hangi riske
      önce bakılacağını söyler — bütün riskleri aynı anda kapatmak zaten mümkün değildir.
    </p>

    <div class="grid gap-5 md:grid-cols-2 mb-8">
      <div class="rounded-2xl ring-1 ring-gray-200 dark:ring-slate-700 bg-white dark:bg-slate-900 p-5">
        <h3 class="font-bold text-heading mb-3">Olasılık</h3>
        <ul class="space-y-2">
          {
            matris.olasilik.map((o) => (
              <li class="flex gap-3 text-sm">
                <span class="shrink-0 w-6 h-6 rounded-md bg-gray-100 dark:bg-slate-800 grid place-items-center font-bold tabular-nums">
                  {o.puan}
                </span>
                <span>
                  <strong class="text-heading">{o.ad}</strong>
                  <span class="text-muted"> — {o.aciklama}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-2xl ring-1 ring-gray-200 dark:ring-slate-700 bg-white dark:bg-slate-900 p-5">
        <h3 class="font-bold text-heading mb-3">Şiddet</h3>
        <ul class="space-y-2">
          {
            matris.siddet.map((o) => (
              <li class="flex gap-3 text-sm">
                <span class="shrink-0 w-6 h-6 rounded-md bg-gray-100 dark:bg-slate-800 grid place-items-center font-bold tabular-nums">
                  {o.puan}
                </span>
                <span>
                  <strong class="text-heading">{o.ad}</strong>
                  <span class="text-muted"> — {o.aciklama}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5 mb-14">
      {
        matris.bantlar.map((b) => (
          <li class:list={['rounded-xl p-4', bantRengi[b.renk]]}>
            <span class="block text-xs font-semibold tabular-nums opacity-80">
              {b.alt}–{b.ust} puan
            </span>
            <span class="block font-bold mt-0.5">{b.ad}</span>
            <span class="block text-xs mt-1.5 leading-snug opacity-90">{b.aksiyon}</span>
          </li>
        ))
      }
    </ul>

    <h2 class="text-2xl font-bold font-heading text-heading mb-3">Örnek risk satırları</h2>
    <p class="text-muted max-w-3xl mb-6">
      Metal işleme atölyesi üzerinden yedi satır. Dikkat edin: önlem sütununda
      "dikkatli çalışılacak" gibi bir cümle yok — her satırda kim, neyi, ne zaman
      yapacak yazıyor. Denetimde de, kazadan sonra da bakılan yer burası.
    </p>

    <div class="overflow-x-auto rounded-2xl ring-1 ring-gray-200 dark:ring-slate-700 mb-14">
      <table class="w-full text-sm min-w-[900px]">
        <thead class="bg-gray-50 dark:bg-slate-800/60">
          <tr class="text-left">
            <th class="px-4 py-3 font-semibold text-heading">Bölüm</th>
            <th class="px-4 py-3 font-semibold text-heading">Tehlike</th>
            <th class="px-4 py-3 font-semibold text-heading">Risk</th>
            <th class="px-4 py-3 font-semibold text-heading">Mevcut durum</th>
            <th class="px-3 py-3 font-semibold text-heading text-center">O</th>
            <th class="px-3 py-3 font-semibold text-heading text-center">Ş</th>
            <th class="px-3 py-3 font-semibold text-heading text-center">Skor</th>
            <th class="px-4 py-3 font-semibold text-heading">Alınacak önlem</th>
            <th class="px-4 py-3 font-semibold text-heading">Sorumlu</th>
            <th class="px-4 py-3 font-semibold text-heading">Termin</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
          {
            ornekRiskSatirlari.map((r) => {
              const skor = r.o * r.s;
              const b = bant(skor);
              return (
                <tr class="align-top bg-white dark:bg-slate-900">
                  <td class="px-4 py-3 font-medium text-heading whitespace-nowrap">{r.bolum}</td>
                  <td class="px-4 py-3 text-default">{r.tehlike}</td>
                  <td class="px-4 py-3 text-muted">{r.risk}</td>
                  <td class="px-4 py-3 text-muted">{r.mevcutOnlem}</td>
                  <td class="px-3 py-3 text-center tabular-nums">{r.o}</td>
                  <td class="px-3 py-3 text-center tabular-nums">{r.s}</td>
                  <td class="px-3 py-3 text-center">
                    <span class:list={['inline-block rounded-md px-2 py-1 font-bold tabular-nums', bantRengi[b.renk]]}>
                      {skor}
                    </span>
                  </td>
                  <td class="px-4 py-3 text-default">{r.onlem}</td>
                  <td class="px-4 py-3 text-muted whitespace-nowrap">{r.sorumlu}</td>
                  <td class="px-4 py-3 text-muted whitespace-nowrap">{r.termin}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold font-heading text-heading mb-3">Acil durum eylem planının iskeleti</h2>
    <p class="text-muted max-w-3xl mb-6">
      Plan bir metin değil, bir düzendir. Aşağıdaki yedi bölüm olmadan plan
      eksik sayılır; her bölümde ne bulunması gerektiğini de yazdık.
    </p>

    <ol class="grid gap-4 sm:grid-cols-2 mb-14">
      {
        ornekAdepBolumleri.map((b) => (
          <li class="rounded-2xl ring-1 ring-gray-200 dark:ring-slate-700 bg-white dark:bg-slate-900 p-5">
            <h3 class="font-bold text-heading mb-3">{b.baslik}</h3>
            <ul class="space-y-1.5">
              {b.icerik.map((i) => (
                <li class="flex gap-2.5 text-sm text-muted leading-snug">
                  <span class="text-primary shrink-0 font-bold" aria-hidden="true">
                    ·
                  </span>
                  <span>{i}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="rounded-2xl bg-primary/5 dark:bg-primary/10 ring-1 ring-primary/20 p-6 md:p-8">
      <h2 class="text-xl font-bold font-heading text-heading mb-2">Kendi dosyanızı kurmak için</h2>
      <p class="text-muted mb-5 max-w-2xl">
        Risk değerlendirmesi işverenin oluşturduğu ekiple yapılır; dışarıdan uzman
        desteği alınabilir. Saha incelemesini yapıp süreci kurabiliriz — sonuçta
        kayıt sizin kaydınız olur.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href="/hizmetler/risk-degerlendirmesi/"
          class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 font-semibold text-white hover:opacity-90 transition"
        >
          Risk değerlendirmesi hizmeti
        </a>
        <a
          href="/isg-kutuphanesi/formlar/"
          class="inline-flex items-center justify-center rounded-full ring-1 ring-gray-300 dark:ring-slate-600 px-6 py-3 font-semibold text-default hover:bg-gray-50 dark:hover:bg-slate-800 transition"
        >
          Boş form şablonları
        </a>
      </div>
    </div>
  </section>
</Layout>
