---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site, isOrtagi } from '~/data/site';

const metadata = {
  title: 'Mobil Sağlık Taraması',
  description: 'İşe giriş ve periyodik muayeneler işyerinizde. Odyometri, SFT, akciğer grafisi ve laboratuvar; vardiya kaybı olmadan.',
};

const sss = [
  { title: 'Mobil sağlık aracı ne yapar?', description: 'İşe giriş ve periyodik muayenelerin işyerinde yapılmasını sağlar. Odyometri, solunum fonksiyon testi, akciğer grafisi ve laboratuvar örneklemesi araçta yapılabilir.' },
  { title: 'Neden işyerine gelen araç?', description: 'Çalışanların tek tek hastaneye gitmesi vardiya kaybı demektir. Araç işyerine geldiğinde aynı gün içinde çok sayıda çalışan taranır, üretim durmaz.' },
  { title: 'Hangi illere geliyor?', description: `Saha hizmeti kapsamımızla aynı: ${site.hizmetIlleri.join(', ')}. OSGB'ler kurulu oldukları il ve sınır komşusu illerde hizmet verebilir.` },
];

const structuredData = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Mobil sağlık taraması',
  serviceType: 'İşyerinde periyodik sağlık muayenesi',
  areaServed: site.hizmetIlleri.map((i) => ({ '@type': 'AdministrativeArea', name: i })),
  provider: { '@type': 'Organization', name: isOrtagi.ad },
}];
---
<Layout metadata={metadata}>
  <StructuredData slot="structured-data" data={structuredData} />
  <Hero
    actions={[{ variant: 'primary', text: 'Tarama planlat', href: '/teklif-al/' }]}
    image={{ src: 'https://images.unsplash.com/photo-1516841273335-e39b37888115?auto=format&fit=crop&w=1200&q=80', alt: 'Mobil sağlık taraması' }}
  >
    <Fragment slot="title">Sağlık taraması <span class="decoration-accent underline decoration-4 underline-offset-8">işyerinize gelir</span></Fragment>
    <Fragment slot="subtitle">
      Periyodik muayene yükümlülüğünün en pahalı kısmı testin kendisi değil,
      çalışanın işten ayrı geçirdiği zamandır. Mobil araç işyerinize geldiğinde
      tarama üretim akışını durdurmadan tamamlanır.
    </Fragment>
  </Hero>

  <Features
    title="Araçta yapılabilenler"
    columns={2}
    items={[
      { title: 'Odyometri', description: 'Gürültülü ortamda çalışanlar için işitme testi.', icon: 'tabler:ear' },
      { title: 'Solunum fonksiyon testi', description: 'Toz, duman ve kimyasal maruziyetinde zorunlu takip.', icon: 'tabler:lungs' },
      { title: 'Akciğer grafisi', description: 'Periyodik sağlık gözetiminin standart parçası.', icon: 'tabler:radioactive' },
      { title: 'Laboratuvar örneklemesi', description: 'Kan ve idrar örnekleri araçta alınır, laboratuvara iletilir.', icon: 'tabler:test-pipe' },
    ]}
  />

  <FAQs title="Sık sorulanlar" items={sss} />
  <CallToAction title="Tarama gününüzü planlayalım" actions={[{ variant: 'primary', text: 'Teklif al', href: '/teklif-al/' }]} />
</Layout>
