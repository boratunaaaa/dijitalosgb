---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { site, isOrtagi } from '~/data/site';
import { ilceler } from '~/data/ilceler';
import { bolgeSektorSayfalari } from '~/data/bolge-sektor';

// Hizmet bölgeleri hub'ı, üretilen bölge-sektör rehberlerinin de giriş
// noktası. Bu liste olmadan yeni içerik yalnız kendi sektör sayfasından
// bağlantı alıyor ve tek inbound link'le orphan page sınırında kalıyordu.
// Liste il bazında gruplanıyor; yüzlerce sayfayı tek ekrana dökmemek için
// ileride ile göre sayfalanabilir.
const bolgeRehberleri = bolgeSektorSayfalari.filter((b) => !b.indexDisi);
const illereGore = [...new Set(bolgeRehberleri.map((b) => b.il))].map((il) => ({
  il,
  sayfalar: bolgeRehberleri.filter((b) => b.il === il),
}));

const metadata = { title: 'OSGB Hizmeti — İstanbul, Kocaeli, Tekirdağ' };
---
<Layout metadata={metadata}>
  <HeroText
    tagline={site.hizmetIlleri.join(' · ')}
    title="OSGB hizmeti"
    subtitle="İş güvenliği uzmanı ve işyeri hekimi görevlendirmesi, risk değerlendirmesi, acil durum planı, ortam ölçümü ve işyerinde mobil sağlık taraması."
    actions={[
      { variant: 'primary', text: 'Teklif al', href: '/teklif-al/' },
      { text: 'Mobil sağlık taraması', href: '/mobil-saglik-taramasi/' },
    ]}
  />

  <Features
    columns={2}
    items={[
      { title: 'İş güvenliği uzmanı', description: 'Görevlendirme, risk değerlendirmesi, acil durum planı ve periyodik saha denetimleri.', icon: 'tabler:shield-check' },
      { title: 'İşyeri hekimi', description: 'İşe giriş ve periyodik muayeneler, sağlık gözetimi kayıtlarının tutulması.', icon: 'tabler:stethoscope' },
      { title: 'Çalışan eğitimi', description: 'Temel eğitim ve yenileme. Uygun tehlike sınıfında tamamı uzaktan verilebilir.', icon: 'tabler:school' },
      { title: 'Ortam ölçümü', description: 'Gürültü, toz ve kimyasal maruziyet ölçümleri; sonuçların rapora bağlanması.', icon: 'tabler:wave-sine' },
    ]}
  />

  <Content
    title="Neden yalnız bu iller"
  >
    <Fragment slot="content">
      <p>
        OSGB'ler kurulu oldukları il ve <strong>sınır komşusu illerde</strong> hizmet
        verebilir; ötesi için o ilde şube açmak gerekir. İş ortağımız {isOrtagi.ad}
        İstanbul'da olduğu için saha kapsamımız {site.hizmetIlleri.join(', ')}.
      </p>
      <p class="mt-3">
        Eğitim tarafında böyle bir sınır yok — orada Türkiye'nin 81 iline hizmet
        veriyoruz.
      </p>
    </Fragment>
  </Content>

  <Features
    title="İlçeler"
    columns={3}
    items={ilceler.map((i) => ({
      title: i.ad,
      description: i.il,
      icon: 'tabler:map-pin',
      callToAction: { text: 'Detay', href: `/osgb/${i.slug}/` },
    }))}
  />

  {
    illereGore.length > 0 && (
      <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 md:py-12">
        <h2 class="text-2xl font-bold text-heading md:text-3xl">Bölge ve sektör rehberleri</h2>
        <p class="mt-3 max-w-3xl text-muted">
          Aynı ilçede farklı iş kolları farklı risk profilleri taşıyor. Aşağıdaki rehberler
          o bölgedeki iş yapış biçimine göre yazıldı; her biri kendi sektörünün öne çıkan
          riskleri ve öncelikli dokümanları üzerine kurulu.
        </p>
        {illereGore.map((g) => (
          <div class="mt-7">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-muted">{g.il}</h3>
            <ul class="mt-3 grid gap-3 sm:grid-cols-2">
              {g.sayfalar.map((b) => (
                <li>
                  <a
                    href={`/bolge/${b.slug}/`}
                    class="block rounded-xl border border-gray-200 p-4 transition hover:border-primary dark:border-slate-700"
                  >
                    <span class="font-semibold text-heading">{b.h1}</span>
                    <span class="mt-1 block text-sm text-muted">{b.ilce}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    )
  }

  <CallToAction
    actions={[{ variant: 'primary', text: 'Teklif al', href: '/teklif-al/' }]}
    title="Yükümlülüğünüzü çıkaralım"
  />
</Layout>
