---
import Base from "../../layouts/Base.astro";
import { site, isOrtagi } from "../../data/site";
import { ilceler } from "../../data/ilceler";

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "OSGB hizmeti",
  serviceType: "İş sağlığı ve güvenliği hizmeti",
  areaServed: site.hizmetIlleri.map((i) => ({ "@type": "AdministrativeArea", name: i })),
  provider: { "@type": "Organization", name: isOrtagi.ad, address: isOrtagi.adres },
};
---
<Base
  title="OSGB Hizmeti — İstanbul, Kocaeli, Tekirdağ"
  description="İş güvenliği uzmanı, işyeri hekimi, risk değerlendirmesi ve mobil sağlık taraması. Saha hizmeti yetki belgeli iş ortağı tarafından verilir."
  schema={schema}
>
  <section class="band">
    <div class="wrap stack">
      <p class="eyebrow">{site.hizmetIlleri.join(" · ")}</p>
      <h1>OSGB hizmeti</h1>
      <p class="prose" style="font-size:1.08rem">
        İş güvenliği uzmanı ve işyeri hekimi görevlendirmesi, risk
        değerlendirmesi, acil durum planı, ortam ölçümü ve işyerinde mobil
        sağlık taraması.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        <a class="btn" href="/teklif-al/">Teklif al</a>
        <a class="btn ghost" href="/mobil-saglik-taramasi/">Mobil sağlık taraması</a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap stack">
      <h2>Neden yalnız bu iller</h2>
      <p class="prose">
        OSGB'ler kurulu oldukları il ve sınır komşusu illerde hizmet verebilir;
        ötesi için o ilde şube açmak gerekir. İş ortağımız İstanbul'da olduğu
        için saha kapsamımız {site.hizmetIlleri.join(", ")}. Eğitim tarafında
        böyle bir sınır yok — orada 81 ile hizmet veriyoruz.
      </p>
      <div><a class="btn ghost" href="/isg-egitimi/">Uzaktan eğitim</a></div>
    </div>
  </section>

  <section class="band">
    <div class="wrap stack">
      <h2>İlçeler</h2>
      <div class="grid">
        {ilceler.map((i) => (
          <a class="card" href={`/osgb/${i.slug}/`} style="text-decoration:none;color:inherit">
            <h3>{i.ad}</h3><p class="muted" style="font-size:.93rem">{i.il}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
