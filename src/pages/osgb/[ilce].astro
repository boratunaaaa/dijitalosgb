---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site, isOrtagi } from '~/data/site';
import { ilceler } from '~/data/ilceler';

export function getStaticPaths() {
  return ilceler.map((i) => ({ params: { ilce: i.slug }, props: { ilce: i } }));
}
const { ilce } = Astro.props;

const metadata = {
  title: `${ilce.ad} OSGB ve İş Güvenliği Hizmeti`,
  description: `${ilce.ad} (${ilce.il}) için iş güvenliği uzmanı, işyeri hekimi ve çalışan eğitimi.`,
};

const structuredData = [{
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `${site.name} — ${ilce.ad} OSGB hizmeti`,
  url: `${site.url}/osgb/${ilce.slug}/`,
  areaServed: { '@type': 'AdministrativeArea', name: `${ilce.ad}, ${ilce.il}` },
  provider: { '@type': 'Organization', name: isOrtagi.ad, address: isOrtagi.adres },
}];
---
<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />
  <HeroText
    tagline={ilce.il}
    title={`${ilce.ad} OSGB ve iş güvenliği hizmeti`}
    subtitle={ilce.vurgu}
    actions={[{ variant: 'primary', text: `${ilce.ad} için teklif al`, href: '/teklif-al/' }]}
  />
  <Features
    title={`${ilce.ad}'de neyi kapsıyoruz`}
    columns={3}
    items={[
      { title: 'İş güvenliği uzmanı', description: 'Görevlendirme, risk değerlendirmesi, acil durum planı.', icon: 'tabler:shield-check' },
      { title: 'İşyeri hekimi', description: 'İşe giriş ve periyodik muayeneler, sağlık gözetimi.', icon: 'tabler:stethoscope' },
      { title: 'Çalışan eğitimi', description: 'Temel eğitim ve yenileme; uygun sınıfta uzaktan.', icon: 'tabler:school' },
    ]}
  />
  <CallToAction
    title="Yetkili OSGB altyapısıyla saha hizmeti"
    subtitle={`Uzman ve hekim görevlendirmeleri Bakanlıkça yetkilendirilmiş çözüm ortağımız ${isOrtagi.ad} üzerinden yürütülür; eğitim, danışmanlık ve dokümantasyonu biz yönetiriz.`}
    actions={[{ variant: 'primary', text: 'Teklif al', href: '/teklif-al/' }]}
  />
</Layout>
