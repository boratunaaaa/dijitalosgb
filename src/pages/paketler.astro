---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site } from '~/data/site';
import { paketler } from '~/data/paketler';
import { hizmetler } from '~/data/hizmetler';

const metadata = {
  title: 'İSG Hizmet Paketleri — İşletme, Şantiye ve Üretim Tesisi',
  description:
    'İş yerinizin tipine göre hangi İSG hizmetlerine ihtiyacınız olduğunu tek sayfada görün: işletme, şantiye ve üretim tesisi paketleri, kapsamları ve sıkça atlanan kalemler.',
};

const bul = (slug: string) => hizmetler.find((h) => h.slug === slug);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: metadata.title,
  description: metadata.description,
  url: `${site.url}/paketler/`,
  inLanguage: 'tr-TR',
  hasPart: paketler.map((p) => ({
    '@type': 'Service',
    name: p.ad,
    description: p.ozet,
    areaServed: site.hizmetIlleri.join(', '),
    provider: { '@type': 'Organization', name: site.name, url: site.url },
  })),
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-14">
    <nav aria-label="Konum" class="mb-6 text-sm text-muted">
      <a href="/" class="hover:underline">Ana sayfa</a>
      <span class="mx-1.5">/</span>
      <span class="text-default">Paketler</span>
    </nav>

    <h1 class="mb-4 text-balance text-3xl font-bold font-heading tracking-tight text-heading md:text-4xl">
      İş yerinize uygun paketi seçin
    </h1>
    <p class="mb-3 max-w-3xl text-lg text-muted">
      Hizmet listesi uzun; hangilerinin size düştüğünü tek tek okumak zorunda değilsiniz.
      Aşağıdaki üç profil, uygulamada en sık karşılaşılan iş yeri tiplerini karşılıyor.
    </p>
    <p class="mb-10 max-w-3xl text-sm text-muted">
      Paketler kapsamı anlatır, yükümlülüğü belirlemez. Sizin yükümlülüğünüz paketin
      içeriğine değil, iş yerinizin tehlike sınıfı ve çalışan sayısına bağlıdır —
      <a class="underline underline-offset-4 hover:no-underline" href="/araclar/isg-yukumluluk-hesaplama/">
        hesaplayıcıdan iki dakikada çıkarabilirsiniz</a>.
    </p>

    <div class="grid gap-6 lg:grid-cols-3">
      {
        paketler.map((p) => (
          <article id={p.slug} class="scroll-mt-24 flex flex-col rounded-2xl border border-gray-200 p-6 dark:border-slate-700">
            <h2 class="text-xl font-bold text-heading">{p.ad}</h2>
            <p class="mt-2 text-sm font-medium text-muted">{p.kimIcin}</p>
            <p class="mt-4 text-sm leading-relaxed text-muted">{p.ozet}</p>

            <h3 class="mt-6 text-xs font-semibold uppercase tracking-wider text-muted">Pakete dahil</h3>
            <ul class="mt-3 space-y-1.5 text-sm">
              {p.hizmetler.map((s) => {
                const h = bul(s);
                return h ? (
                  <li>
                    <a class="underline underline-offset-4 hover:no-underline" href={`/hizmetler/${h.slug}/`}>
                      {h.ad}
                    </a>
                  </li>
                ) : null;
              })}
            </ul>

            <h3 class="mt-6 text-xs font-semibold uppercase tracking-wider text-muted">Bu profilde sık atlanan</h3>
            <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-muted">
              {p.vurgular.map((v) => <li>{v}</li>)}
            </ul>

            <a
              href={`/teklif-al/?paket=${p.slug}`}
              class="mt-7 inline-flex items-center justify-center rounded-full bg-primary px-5 py-2.5 font-semibold text-white transition hover:opacity-90"
            >
              {p.ad} için ön değerlendirme
            </a>
          </article>
        ))
      }
    </div>

    <div class="mt-12 rounded-2xl bg-gray-50 p-6 dark:bg-slate-800/60 md:p-8">
      <h2 class="text-xl font-bold text-heading">Neden fiyat yazmıyoruz</h2>
      <p class="mt-3 max-w-3xl text-muted">
        İSG hizmetinin bedeli tehlike sınıfına, çalışan sayısına, sahaya ayrılacak süreye ve
        ölçüm kapsamına göre değişir. Sayfaya tek bir rakam koymak ya sizin iş yerinize
        uymayan bir sayı olur ya da sonradan bozulacak bir taahhüt. Bunun yerine ön
        değerlendirmede kapsamı yazılı çıkarıp bedeli onun üzerinden veriyoruz.
      </p>
      <p class="mt-4 max-w-3xl text-muted">
        Teklifleri karşılaştırırken tek ortak payda yönetmelikteki asgari süredir: her teklifi
        <strong> "ayda kaç saat uzman, kaç saat hekim"</strong> sorusuna indirin, aylık tutarı bu
        saate bölün. Ortam ölçümü, periyodik kontrol ve eğitimlerin fiyata dahil olup
        olmadığını da yazılı isteyin.
      </p>
    </div>
  </section>
</Layout>
