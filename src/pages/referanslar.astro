---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site, isOrtagi, uzman } from '~/data/site';
import { isOrtagiReferanslari, uzmanReferanslari, referansSayisi } from '~/data/referanslar';
import { katipReferanslari, katipReferansSayisi } from '~/data/katip-referanslar';

// Liste hizmet SÖZLEŞMELERİNDEN çıkarıldı; aynı iş yeriyle birden fazla
// sözleşme olabildiği için sözleşme sayısı ile ayrı iş yeri sayısı aynı
// değil. İkisini de yazmak, tek büyük sayı yazmaktan daha güvenilir.
const benzersizSayisi = new Set(katipReferanslari.map((k) => k.ad)).size;

const metadata = {
  title: 'Referanslar — Hizmet Verilen Kurumlar',
  description: `İSG uzmanı olarak görev alınan projeler ve saha hizmetini veren yetkili iş ortağımızın hizmet verdiği ${referansSayisi} kurum.`,
};

const sayfaUrl = `${site.url}/referanslar/`;

// Tehlike sınıfı rozetleri — listenin kuru bir isim yığını olmaması için.
const sinifAdi = { az: 'Az tehlikeli', teh: 'Tehlikeli', cok: 'Çok tehlikeli', '': '' } as const;
const sinifRengi = {
  az: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300',
  teh: 'bg-amber-50 text-amber-700 dark:bg-amber-500/10 dark:text-amber-300',
  cok: 'bg-rose-50 text-rose-700 dark:bg-rose-500/10 dark:text-rose-300',
  '': '',
} as const;
const sinifSayisi = {
  cok: katipReferanslari.filter((k) => k.sinif === 'cok').length,
  teh: katipReferanslari.filter((k) => k.sinif === 'teh').length,
  az: katipReferanslari.filter((k) => k.sinif === 'az').length,
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Referanslar', item: sayfaUrl },
  ],
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={breadcrumb} />

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <nav aria-label="Konum" class="text-sm text-muted mb-6">
      <a href="/" class="hover:underline">Ana sayfa</a>
      <span class="mx-1.5">/</span>
      <span class="text-default">Referanslar</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-bold font-heading text-heading tracking-tight mb-4">Referanslar</h1>
    <p class="text-lg text-muted max-w-3xl mb-12">
      Aşağıdaki listeler bilerek ayrı duruyor. İSG eğitimlerini ve uzmanlık
      hizmetini doğrudan veriyoruz; saha OSGB hizmetini yetkili iş ortağımız
      veriyor. Hangi işin kimin üzerinden yürüdüğünü listede de görebilmeniz için
      ayırdık.
    </p>

    <div class="mb-14">
      <h2 class="text-2xl font-bold font-heading text-heading mb-2">
        Saha deneyimimizden bazı projeler
      </h2>
      <p class="text-muted mb-2">
        Ekibimizin geçmiş saha ve uzmanlık deneyiminde Türkiye'nin önde gelen kurum ve
        yüklenicilerinin projeleri bulunuyor. {uzman.unvan}
        {uzman.belgeSinifi ? ` (${uzman.belgeSinifi} sınıfı)` : ''} olarak bu projelerde
        iş güvenliği uzmanı görevi üstlenildi.
      </p>
      <p class="text-sm text-muted mb-6">
        Bu kurumlar {site.name}'in müşterisi olarak değil, görev alınan projelerin işvereni
        veya yüklenicisi olarak listeleniyor. Marka adları yalnız bu bağlamı göstermek için
        düz metin olarak veriliyor; logo kullanılmıyor.
      </p>
      <ul class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {
          uzmanReferanslari.map((ad) => (
            <li class="rounded-xl ring-1 ring-gray-200 dark:ring-slate-700 bg-white dark:bg-slate-900 px-4 py-5 text-center font-semibold text-heading">
              {ad}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mb-14">
      <h2 class="text-2xl font-bold font-heading text-heading mb-2">
        Sözleşmeyle hizmet verilen iş yerleri
      </h2>
      <p class="text-muted mb-5 max-w-3xl">
        Liste, İSG-KATİP'te — Çalışma ve Sosyal Güvenlik
        Bakanlığı'nın kayıt sisteminde — adımıza tanımlanmış hizmet
        sözleşmelerinden çıkarıldı. {katipReferansSayisi} hizmet sözleşmesi, {benzersizSayisi} ayrı iş yeri.
        İnşaattan gıdaya, metalden lojistiğe her tehlike sınıfında saha
        tecrübesi demek.
      </p>

      <dl class="grid grid-cols-3 gap-3 mb-6 max-w-lg">
        <div class="rounded-xl bg-rose-50 dark:bg-rose-500/10 px-4 py-3">
          <dt class="text-xs font-medium text-rose-700 dark:text-rose-300">Çok tehlikeli</dt>
          <dd class="text-2xl font-bold text-rose-700 dark:text-rose-300 tabular-nums">{sinifSayisi.cok}</dd>
        </div>
        <div class="rounded-xl bg-amber-50 dark:bg-amber-500/10 px-4 py-3">
          <dt class="text-xs font-medium text-amber-700 dark:text-amber-300">Tehlikeli</dt>
          <dd class="text-2xl font-bold text-amber-700 dark:text-amber-300 tabular-nums">{sinifSayisi.teh}</dd>
        </div>
        <div class="rounded-xl bg-emerald-50 dark:bg-emerald-500/10 px-4 py-3">
          <dt class="text-xs font-medium text-emerald-700 dark:text-emerald-300">Az tehlikeli</dt>
          <dd class="text-2xl font-bold text-emerald-700 dark:text-emerald-300 tabular-nums">{sinifSayisi.az}</dd>
        </div>
      </dl>

      <ul class="grid gap-x-6 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
        {
          katipReferanslari.map((k) => (
            <li class="flex items-start gap-2 text-sm text-default leading-snug py-1 border-b border-gray-100 dark:border-slate-800">
              <span
                class:list={['mt-0.5 shrink-0 rounded px-1.5 py-0.5 text-[10px] font-semibold', sinifRengi[k.sinif]]}
                title={sinifAdi[k.sinif]}
              >
                {k.sinif === 'cok' ? 'ÇT' : k.sinif === 'teh' ? 'T' : 'AT'}
              </span>
              <span>{k.ad}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-2xl font-bold font-heading text-heading mb-2">
        İş ortağımızın hizmet verdiği kurumlar
      </h2>
      <p class="text-muted mb-6 max-w-3xl">
        Saha iş sağlığı ve güvenliği hizmetleri, Çalışma ve Sosyal Güvenlik
        Bakanlığı'ndan yetkili iş ortağımız <strong>{isOrtagi.ad}</strong> tarafından
        veriliyor. Aşağıdaki {referansSayisi} kurum onun portföyüdür.
      </p>
      <p class="text-sm text-muted mb-4">
        Renkli olanlar iki listede birden yer alıyor: hem iş ortağımızın portföyünde,
        hem de doğrudan görev aldığımız kurumlar arasında.
      </p>
      <ul class="flex flex-wrap gap-2">
        {
          isOrtagiReferanslari.map((ad) => (
            <li
              class:list={[
                'rounded-full px-3.5 py-1.5 text-sm',
                uzmanReferanslari.includes(ad)
                  ? 'bg-primary/10 text-primary font-semibold'
                  : 'bg-gray-100 dark:bg-slate-800 text-default',
              ]}
            >
              {ad}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-14 rounded-2xl bg-primary/5 dark:bg-primary/10 ring-1 ring-primary/20 p-6 md:p-8">
      <h2 class="text-xl font-bold font-heading text-heading mb-2">Sizin işyeriniz hangi listede olurdu?</h2>
      <p class="text-muted mb-5 max-w-2xl">
        Tehlike sınıfınızı ve çalışan sayınızı söyleyin; yükümlülüğünüzü çıkarıp
        yazılı teklifle dönelim.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href="/teklif-al/"
          class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 font-semibold text-white hover:opacity-90 transition"
        >
          Teklif al
        </a>
        <a
          href="/araclar/isg-yukumluluk-hesaplama/"
          class="inline-flex items-center justify-center rounded-full ring-1 ring-gray-300 dark:ring-slate-600 px-6 py-3 font-semibold text-default hover:bg-gray-50 dark:hover:bg-slate-800 transition"
        >
          Önce kendim hesaplayayım
        </a>
      </div>
    </div>
  </section>
</Layout>
