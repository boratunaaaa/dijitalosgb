---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { rehberler } from '~/data/rehber';

export function getStaticPaths() {
  return rehberler.map((r) => ({ params: { konu: r.slug }, props: { r } }));
}
const { r } = Astro.props;
const metadata = { title: r.soru, description: r.ozet };

const structuredData = [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: r.soru,
    acceptedAnswer: { '@type': 'Answer', text: `${r.cevap} ${r.detay.join(' ')}` },
  }],
}];
---
<Layout metadata={metadata}>
  <StructuredData slot="structured-data" data={structuredData} />
  <HeroText tagline="Rehber" title={r.soru} subtitle={r.ozet} />
  <div class="mx-auto max-w-3xl px-4 sm:px-6 pb-8">
    <p class="text-lg">{r.cevap}</p>
  </div>
  <Features
    columns={1}
    items={r.detay.map((d) => ({ title: d, icon: 'tabler:point' }))}
  />
  <CallToAction title="Kendi durumumu sorayım" actions={[{ variant: 'primary', text: 'Teklif al', href: '/teklif-al/' }]} />
</Layout>
