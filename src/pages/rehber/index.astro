---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { rehberler } from '~/data/rehber';

const metadata = { title: 'İSG Rehberi', description: 'OSGB zorunluluğu, tehlike sınıfı ve uzaktan eğitim kuralları — yönetmeliğe dayalı net cevaplar.' };
---
<Layout metadata={metadata}>
  <HeroText title="İSG rehberi" subtitle="Sık sorulan sorulara yönetmeliğe dayalı, kısa ve kesin cevaplar." />
  <Features
    columns={1}
    items={rehberler.map((r) => ({
      title: r.soru,
      description: r.ozet,
      icon: 'tabler:help-circle',
      callToAction: { text: 'Cevabı oku', href: `/rehber/${r.slug}/` },
    }))}
  />
  <CallToAction title="Kendi durumunuzu soralım" actions={[{ variant: 'primary', text: 'Teklif al', href: '/teklif-al/' }]} />
</Layout>
