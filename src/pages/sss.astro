---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { site } from '~/data/site';
import { sorular, kategoriAdlari, soruSayisi, type SssKategori } from '~/data/sss';

const metadata = {
  title: 'Sıkça Sorulan Sorular — İSG, OSGB ve Yükümlülükler',
  description: `İSG zorunluluğu, uzman ve hekim süreleri, eğitim saatleri, risk değerlendirmesi, sağlık raporları ve denetim hakkında ${soruSayisi} soru ve cevabı.`,
};

const sayfaUrl = `${site.url}/sss/`;

// Kategori sırası: ziyaretçinin sorma sırası. Önce "gerekli mi", sonra
// "kim yapar", en sonda "nasıl başlarız".
const sira: SssKategori[] = ['zorunluluk', 'profesyonel', 'egitim', 'risk', 'saglik', 'denetim', 'surec'];
const gruplu = sira.map((k) => ({
  anahtar: k,
  ad: kategoriAdlari[k],
  liste: sorular.filter((s) => s.kategori === k),
}));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: sorular.map((s) => ({
    '@type': 'Question',
    name: s.soru,
    acceptedAnswer: { '@type': 'Answer', text: s.cevap },
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Sıkça sorulan sorular', item: sayfaUrl },
  ],
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={faqSchema} />
  <StructuredData slot="head" schema={breadcrumb} />

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <nav aria-label="Konum" class="text-sm text-muted mb-6">
      <a href="/" class="hover:underline">Ana sayfa</a>
      <span class="mx-1.5">/</span>
      <span class="text-default">Sıkça sorulan sorular</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-bold font-heading text-heading tracking-tight mb-4">
      Sıkça sorulan sorular
    </h1>
    <p class="text-lg text-muted mb-8">
      İşverenlerin en çok sorduğu {soruSayisi} soru. Cevaplar mevzuata dayanıyor;
      her yıl değişen para cezası tutarları gibi sayılar bilerek yazılmadı, çünkü
      bugün doğru yazılan rakam yarın yanlış oluyor.
    </p>

    <nav class="flex flex-wrap gap-2 mb-12" aria-label="Kategoriler">
      {
        gruplu.map((g) => (
          <a
            href={`#${g.anahtar}`}
            class="rounded-full bg-gray-100 dark:bg-slate-800 px-3.5 py-1.5 text-sm font-medium text-default hover:bg-primary/10 hover:text-primary transition"
          >
            {g.ad} ({g.liste.length})
          </a>
        ))
      }
    </nav>

    {
      gruplu.map((g) => (
        <div id={g.anahtar} class="mb-12 scroll-mt-24">
          <h2 class="text-2xl font-bold font-heading text-heading mb-5">{g.ad}</h2>
          <div class="space-y-3">
            {g.liste.map((s) => (
              <details class="group rounded-xl ring-1 ring-gray-200 dark:ring-slate-700 bg-white dark:bg-slate-900 overflow-hidden">
                <summary class="cursor-pointer list-none px-5 py-4 font-semibold text-heading flex items-start justify-between gap-4 hover:bg-gray-50 dark:hover:bg-slate-800/60">
                  <span>{s.soru}</span>
                  <span class="shrink-0 text-muted transition-transform group-open:rotate-45 text-xl leading-none" aria-hidden="true">
                    +
                  </span>
                </summary>
                <div class="px-5 pb-5 text-muted leading-relaxed">{s.cevap}</div>
              </details>
            ))}
          </div>
        </div>
      ))
    }

    <div class="rounded-2xl bg-primary/5 dark:bg-primary/10 ring-1 ring-primary/20 p-6 md:p-8">
      <h2 class="text-xl font-bold font-heading text-heading mb-2">Sorunuzun cevabı yoksa</h2>
      <p class="text-muted mb-5">
        İşyerinize özgü bir durumu birkaç dakikada konuşup netleştirebiliriz.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href="/teklif-al/"
          class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 font-semibold text-white hover:opacity-90 transition"
        >
          Teklif al
        </a>
        {
          site.telefon && (
            <a
              href={`tel:${site.telefonHref}`}
              class="inline-flex items-center justify-center rounded-full ring-1 ring-gray-300 dark:ring-slate-600 px-6 py-3 font-semibold text-default hover:bg-gray-50 dark:hover:bg-slate-800 transition"
            >
              {site.telefon}
            </a>
          )
        }
      </div>
    </div>
  </section>
</Layout>
