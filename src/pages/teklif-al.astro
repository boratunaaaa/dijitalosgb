---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import { site } from '~/data/site';
import { ilceler } from '~/data/ilceler';

const metadata = {
  title: 'Ücretsiz İSG Ön Değerlendirmesi',
  description:
    'Faaliyet alanınızı, çalışan sayınızı ve konumunuzu bildirin; tehlike sınıfınızı çıkarıp yasal yükümlülüğünüzü ve kapsamı yazılı olarak iletelim. Ücretsiz ve bağlayıcı değil.',
};
const alan = 'w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-base text-gray-900 focus:border-primary focus:ring-1 focus:ring-primary';
---
<Layout metadata={metadata}>
  <HeroText
    title="Ücretsiz İSG ön değerlendirmesi"
    subtitle="Faaliyet alanınız, çalışan sayınız ve konumunuza göre yasal yükümlülüğünüzü çıkaralım. Üç şey yeterli: işin ne olduğu, kaç kişi çalıştığı ve nerede olduğu — tehlike sınıfını NACE koduna göre biz buluruz."
  />

  {/*
    Söz veriyoruz, o yüzden sınırını da yazıyoruz. Aşağıdaki dört madde
    tutulabilir olduğu için burada: değerlendirme gerçekten ücretsiz,
    zorunlu olmayan hizmet önerilmiyor, kapsam yazılı veriliyor ve formu
    okuyan gerçek bir uzman. Tutulamayacak bir süre taahhüdü yazılmadı.
  */}
  <section class="mx-auto max-w-2xl px-4 sm:px-6 pb-4">
    <ul class="grid gap-3 rounded-2xl bg-gray-50 p-5 text-sm dark:bg-slate-800/60 sm:grid-cols-2">
      {
        [
          'Ücretsiz ve bağlayıcı değil',
          'Zorunlu olmayan hizmet önerilmez',
          'Kapsam yazılı olarak verilir',
          'Formu A sınıfı İSG uzmanı değerlendirir',
        ].map((m) => (
          <li class="flex items-start gap-2">
            <span aria-hidden="true" class="mt-0.5 font-bold text-primary">✓</span>
            <span>{m}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-2xl px-4 sm:px-6 pb-16">
    <form method="post" action="/api/teklif" class="relative flex flex-col gap-5">
      <div class="flex flex-col gap-2">
        <label for="firma" class="font-medium">Firma adı</label>
        <input id="firma" name="firma" type="text" required class={alan} />
      </div>
      <div class="flex flex-col gap-2">
        <label for="faaliyet" class="font-medium">Ne iş yapıyorsunuz?</label>
        <input id="faaliyet" name="faaliyet" type="text" required placeholder="örn. tekstil üretimi, muhasebe ofisi" class={alan} />
      </div>
      <div class="flex flex-col gap-2">
        <label for="calisan" class="font-medium">Çalışan sayısı</label>
        <input id="calisan" name="calisan" type="number" min="1" required class={alan} />
      </div>
      <div class="flex flex-col gap-2">
        <label for="konum" class="font-medium">Konum</label>
        <select id="konum" name="konum" required class={alan}>
          {ilceler.map((i) => <option value={i.slug}>{i.ad} ({i.il})</option>)}
          <option value="diger">Başka il — yalnız uzaktan eğitim</option>
        </select>
      </div>
      <div class="flex flex-col gap-2">
        <label for="ilgi" class="font-medium">Neyle ilgileniyorsunuz? <span class="font-normal text-muted">(isteğe bağlı)</span></label>
        <input id="ilgi" name="ilgi" type="text" placeholder="örn. risk değerlendirmesi, şantiye paketi" class={alan} />
      </div>
      <div class="flex flex-col gap-2">
        <label for="iletisim" class="font-medium">Size nasıl dönelim?</label>
        <input id="iletisim" name="iletisim" type="text" required placeholder="telefon veya e-posta" class={alan} />
      </div>
      {/*
        Bal küpü: ekran okuyucudan ve klavye sırasından çıkarıldı, gözle de
        görünmüyor. Gerçek ziyaretçi dolduramaz; dolu geldiyse gönderen bot.
        `display:none` yerine konumlandırma kullanılıyor — bazı botlar gizli
        alanları `display` üzerinden ayırt edip atlıyor.
      */}
      <div aria-hidden="true" class="absolute left-[-9999px] top-auto h-px w-px overflow-hidden">
        <label for="website">Bu alanı boş bırakın</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <input id="acilis" name="acilis" type="hidden" value="" />

      <label class="flex items-start gap-3 text-sm">
        <input id="ticari-izin" name="ticari_izin" type="checkbox" value="evet" class="mt-1" />
        <span class="text-muted">
          İSG mevzuatındaki değişiklikler ve hizmetlerle ilgili bilgilendirme
          e-postası almak istiyorum. <strong>İsteğe bağlıdır</strong>; teklif almak için
          işaretlemeniz gerekmez.
        </span>
      </label>

      <button type="submit" class="btn btn-primary w-full sm:w-auto">Ücretsiz ön değerlendirme al</button>

      <p class="text-sm text-muted">
        Formu göndererek <a href="/kvkk/" class="underline">KVKK Aydınlatma Metni</a>'ni
        okuduğunuzu kabul edersiniz. Bilgileriniz yalnız teklif hazırlamak için
        kullanılır, pazarlama listesine eklenmez.
      </p>
      <p class="text-sm text-muted">
        Uzmanlık ve hekimlik görevlendirmeleri, Bakanlıkça yetkilendirilmiş çözüm ortağımız
        üzerinden yürütülür; eğitim, danışmanlık ve dokümantasyon {site.name} tarafından
        yönetilir. ({site.name} bir OSGB değildir.)
      </p>
    </form>
  </section>

  {/* Hesaplayıcıdan gelindiyse orada girilen değerler burada hazır gelsin;
      ziyaretçi aynı bilgiyi ikinci kez yazmak zorunda kalmasın. Değerler
      yalnız URL'den okunur, hiçbir yere kaydedilmez. */}
  <script>
    // Formun açıldığı an: sunucu tarafında "insan bu kadar hızlı dolduramaz"
    // kontrolü için. Kaydedilmiyor, yalnız gönderimle birlikte gidiyor.
    const acilisAlani = document.getElementById('acilis') as HTMLInputElement | null;
    if (acilisAlani) acilisAlani.value = String(Date.now());

    const p = new URLSearchParams(location.search);
    const calisan = p.get('calisan');
    const sinif = p.get('sinif');

    // Hizmet veya paket sayfasından gelindiyse ne istediğini tekrar yazmasın.
    const ETIKET: Record<string, string> = {
      isletme: 'İşletme paketi',
      santiye: 'Şantiye paketi',
      uretim: 'Üretim tesisi paketi',
    };
    const paket = p.get('paket');
    const hizmet = p.get('hizmet');
    const ilgi = document.getElementById('ilgi') as HTMLInputElement | null;
    if (ilgi && !ilgi.value) {
      if (paket && ETIKET[paket]) ilgi.value = ETIKET[paket];
      else if (hizmet && /^[a-z0-9-]{3,60}$/.test(hizmet)) ilgi.value = hizmet.replace(/-/g, ' ');
    }

    if (calisan) {
      const el = document.getElementById('calisan') as HTMLInputElement | null;
      if (el && /^\d{1,6}$/.test(calisan)) el.value = calisan;
    }

    if (sinif) {
      const ADLAR: Record<string, string> = {
        'az-tehlikeli': 'az tehlikeli',
        tehlikeli: 'tehlikeli',
        'cok-tehlikeli': 'çok tehlikeli',
      };
      const ad = ADLAR[sinif];
      const faaliyet = document.getElementById('faaliyet') as HTMLInputElement | null;
      if (ad && faaliyet && !faaliyet.value) {
        faaliyet.placeholder = `örn. tekstil üretimi (${ad} sınıf)`;
      }
      if (ad) {
        const form = document.querySelector('form');
        const not = document.createElement('p');
        not.className =
          'text-sm rounded-lg bg-primary/10 text-primary px-4 py-3 font-medium';
        not.textContent = `Hesaplamadan geldiniz: ${ad} sınıf${calisan ? `, ${calisan} çalışan` : ''}. Bilgileri kontrol edip gönderin.`;
        form?.prepend(not);
      }
    }
  </script>
</Layout>
